{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Rejected: ${jobType}",
      "weight": "Bolder",
      "size": "Large",
      "color": "Attention",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Your request was not approved.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Ticket",        "value": "${ticketNumber}" },
        { "title": "Rejected by",   "value": "${rejectorName}" },
        { "title": "Stage",         "value": "${stageName}" }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Reason", "weight": "Bolder" },
        { "type": "TextBlock", "text": "${rejectReason}", "wrap": true }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open ticket",
      "url": "${ticketUrl}"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Discuss in Teams",
      "url": "https://teams.microsoft.com/l/channel/CHANGE_ME"
    }
  ]
}
