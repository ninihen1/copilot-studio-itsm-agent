{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Approved: ${jobType}",
      "weight": "Bolder",
      "size": "Large",
      "color": "Good",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Your request has been approved by ${approverName} and is now being processed.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Ticket",   "value": "${ticketNumber}" },
        { "title": "Action",   "value": "${actionDescription}" },
        { "title": "Status",   "value": "Queued for execution" }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Track progress",
      "url": "${ticketUrl}"
    }
  ]
}
