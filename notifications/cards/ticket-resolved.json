{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Your ticket is resolved",
      "weight": "Bolder",
      "size": "Large",
      "color": "Good",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Ticket",     "value": "${ticketNumber}" },
        { "title": "Summary",    "value": "${shortDescription}" },
        { "title": "Resolved by","value": "${resolverName}" },
        { "title": "Close code", "value": "${closeCode}" }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        { "type": "TextBlock", "text": "Resolution notes", "weight": "Bolder" },
        { "type": "TextBlock", "text": "${closeNotes}", "wrap": true }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Was this resolved to your satisfaction?",
      "weight": "Bolder",
      "spacing": "Medium",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Yes, all good",
      "style": "positive",
      "data": { "feedback": "satisfied", "ticketId": "${ticketId}" }
    },
    {
      "type": "Action.ShowCard",
      "title": "Reopen",
      "card": {
        "type": "AdaptiveCard",
        "body": [
          {
            "type": "Input.Text",
            "id": "reopenReason",
            "label": "What's still wrong?",
            "isMultiline": true,
            "isRequired": true
          }
        ],
        "actions": [
          {
            "type": "Action.Submit",
            "title": "Reopen ticket",
            "style": "destructive",
            "data": { "feedback": "reopen", "ticketId": "${ticketId}" }
          }
        ]
      }
    },
    {
      "type": "Action.OpenUrl",
      "title": "Knowledge base",
      "url": "${kbUrl}"
    }
  ]
}
