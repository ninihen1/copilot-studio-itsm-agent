{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": { "defaultValue": {}, "type": "Object" },
    "$authentication": { "defaultValue": {}, "type": "SecureObject" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": ["siteUrl"],
          "properties": {
            "siteUrl": {
              "type": "string",
              "description": "Full SharePoint site URL, e.g. https://contoso.sharepoint.com/sites/DevJohn"
            }
          }
        },
        "triggerAuthenticationType": "Anonymous"
      }
    }
  },
  "actions": {
    "Compose_IsInternal": {
      "runAfter": {},
      "type": "Compose",
      "inputs": "@or(contains(toLower(triggerBody()?['siteUrl']), 'contoso.sharepoint.com'), contains(toLower(triggerBody()?['siteUrl']), 'flowstudio.app'))"
    },
    "Get_Web": {
      "runAfter": { "Compose_IsInternal": ["Succeeded"] },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@triggerBody()?['siteUrl']",
          "parameters/method": "GET",
          "parameters/uri": "_api/web?$select=Title,Url,Description"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Get_Site_Owner": {
      "runAfter": { "Get_Web": ["Succeeded"] },
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "@triggerBody()?['siteUrl']",
          "parameters/method": "GET",
          "parameters/uri": "_api/site/Owner?$select=Title,Email,LoginName,UserPrincipalName"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Return_Success": {
      "runAfter": { "Get_Site_Owner": ["Succeeded"] },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "body": {
          "siteUrl": "@triggerBody()?['siteUrl']",
          "exists": true,
          "isInternal": "@outputs('Compose_IsInternal')",
          "title": "@coalesce(body('Get_Web')?['d']?['Title'], body('Get_Web')?['Title'])",
          "description": "@coalesce(body('Get_Web')?['d']?['Description'], body('Get_Web')?['Description'])",
          "ownerName": "@coalesce(body('Get_Site_Owner')?['d']?['Title'], body('Get_Site_Owner')?['Title'])",
          "ownerEmail": "@coalesce(body('Get_Site_Owner')?['d']?['Email'], body('Get_Site_Owner')?['Email'])",
          "ownerUpn": "@coalesce(body('Get_Site_Owner')?['d']?['UserPrincipalName'], body('Get_Site_Owner')?['UserPrincipalName'])",
          "ownerLoginName": "@coalesce(body('Get_Site_Owner')?['d']?['LoginName'], body('Get_Site_Owner')?['LoginName'])",
          "errorMessage": ""
        }
      }
    },
    "Return_Failure_Web": {
      "runAfter": { "Get_Web": ["Failed", "TimedOut"] },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "body": {
          "siteUrl": "@triggerBody()?['siteUrl']",
          "exists": false,
          "isInternal": "@outputs('Compose_IsInternal')",
          "title": null,
          "description": null,
          "ownerName": null,
          "ownerEmail": null,
          "ownerUpn": null,
          "ownerLoginName": null,
          "errorMessage": "@{coalesce(actions('Get_Web')?['error']?['message'], 'Site not accessible to the calling user, or does not exist.')}"
        }
      }
    },
    "Return_Failure_Owner": {
      "runAfter": { "Get_Site_Owner": ["Failed", "TimedOut"] },
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "body": {
          "siteUrl": "@triggerBody()?['siteUrl']",
          "exists": true,
          "isInternal": "@outputs('Compose_IsInternal')",
          "title": "@coalesce(body('Get_Web')?['d']?['Title'], body('Get_Web')?['Title'])",
          "description": "@coalesce(body('Get_Web')?['d']?['Description'], body('Get_Web')?['Description'])",
          "ownerName": null,
          "ownerEmail": null,
          "ownerUpn": null,
          "ownerLoginName": null,
          "errorMessage": "@{concat('Site exists but Owner lookup failed: ', coalesce(actions('Get_Site_Owner')?['error']?['message'], 'unknown'))}"
        }
      }
    }
  }
}
