{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "integer"
            },
            "parentRitmId": {
              "type": "integer"
            },
            "parentTicketId": {
              "type": "integer"
            },
            "taskState": {
              "type": "string"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "If_Task_Reached_Terminal_State": {
      "actions": {
        "Get_Sibling_Tasks": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tasks",
              "$filter": "@{concat('ParentRitm/Id eq ', outputs('Get_Task_Fresh')?['body/ParentRitm/Id'])}",
              "$top": 50
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Compose_All_Closed": {
          "runAfter": {
            "Filter_Closed_Tasks": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(length(body('Filter_Closed_Tasks')), length(body('Get_Sibling_Tasks')?['value']))"
        },
        "Compose_Any_Failed": {
          "runAfter": {
            "Filter_Failed_Tasks": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@greater(length(body('Filter_Failed_Tasks')), 0)"
        },
        "If_All_Tasks_Closed": {
          "actions": {
            "Patch_RITM_Closed": {
              "runAfter": {
                "Get_Parent_RITM": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']",
                  "item/Title": "@body('Get_Parent_RITM')?['Title']",
                  "item/RitmNumber": "@body('Get_Parent_RITM')?['RitmNumber']",
                  "item/ParentTicket/Id": "@body('Get_Parent_RITM')?['ParentTicket']?['Id']",
                  "item/CatalogItem/Id": "@body('Get_Parent_RITM')?['CatalogItem']?['Id']",
                  "item/RequestedFor/Claims": "@body('Get_Parent_RITM')?['RequestedFor']?['Claims']",
                  "item/RitmState/Value": "@if(outputs('Compose_Any_Failed'), 'Closed Incomplete', 'Closed Complete')",
                  "item/OpenedDate": "@body('Get_Parent_RITM')?['OpenedDate']",
                  "item/ConfidentialityLevel/Value": "@body('Get_Parent_RITM')?['ConfidentialityLevel']?['Value']",
                  "item/CloseCode/Value": "@if(outputs('Compose_Any_Failed'), 'Rejected', 'Fulfilled')",
                  "item/ClosedDate": "@utcNow()",
                  "item/CloseNotes": "@{concat('All ', length(body('Get_Sibling_Tasks')?['value']), ' SCTASK(s) reached terminal state. Failures: ', if(outputs('Compose_Any_Failed'), 'yes', 'no'), '.')}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_Parent_RITM": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Get_Sibling_RITMs": {
              "runAfter": {
                "Patch_RITM_Closed": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "$filter": "@{concat('ParentTicket/Id eq ', body('Get_Parent_RITM')?['ParentTicket']?['Id'])}",
                  "$top": 50
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Compose_All_RITMs_Closed": {
              "runAfter": {
                "Filter_Closed_RITMs": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@equals(length(body('Filter_Closed_RITMs')), length(body('Get_Sibling_RITMs')?['value']))"
            },
            "Compose_Any_RITM_Failed": {
              "runAfter": {
                "Filter_Failed_RITMs": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@greater(length(body('Filter_Failed_RITMs')), 0)"
            },
            "If_All_RITMs_Closed": {
              "actions": {
                "Get_Parent_Ticket": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Tickets",
                      "id": "@body('Get_Parent_RITM')?['ParentTicket']?['Id']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Patch_Ticket_Resolved": {
                  "runAfter": {
                    "Get_Parent_Ticket": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Tickets",
                      "id": "@body('Get_Parent_RITM')?['ParentTicket']?['Id']",
                      "item/Title": "@body('Get_Parent_Ticket')?['Title']",
                      "item/TicketType/Value": "@body('Get_Parent_Ticket')?['TicketType']?['Value']",
                      "item/CategoryRef/Id": "@body('Get_Parent_Ticket')?['CategoryRef']?['Id']",
                      "item/Caller/Claims": "@body('Get_Parent_Ticket')?['Caller']?['Claims']",
                      "item/TicketState/Value": "Resolved",
                      "item/Impact/Value": "@body('Get_Parent_Ticket')?['Impact']?['Value']",
                      "item/Urgency/Value": "@body('Get_Parent_Ticket')?['Urgency']?['Value']",
                      "item/ShortDescription": "@body('Get_Parent_Ticket')?['ShortDescription']",
                      "item/ConfidentialityLevel/Value": "@body('Get_Parent_Ticket')?['ConfidentialityLevel']?['Value']",
                      "item/ResolvedDate": "@utcNow()",
                      "item/CloseCode/Value": "@if(outputs('Compose_Any_RITM_Failed'), 'Not Solved (Not Reproducible)', 'Solved Permanently')",
                      "item/CloseNotes": "@{concat('All ', length(body('Get_Sibling_RITMs')?['value']), ' RITM(s) reached terminal state. Auto-resolved by SCTASK Orchestrator.')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Post_Ticket_Resolved_Notification": {
                  "runAfter": {
                    "Patch_Ticket_Resolved": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                      "connectionName": "shared_teams",
                      "operationId": "PostMessageToConversation"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Chat with Flow bot",
                      "body/recipient": "@{coalesce(body('Get_Parent_Ticket')?['Caller']?['Email'], last(split(coalesce(body('Get_Parent_Ticket')?['Caller']?['Claims'], ''), '|')), 'catherine.han@flowstudio.app')}",
                      "body/messageBody": "@{concat('<h2>Ticket resolved</h2><p><b>Ticket:</b> ', body('Get_Parent_Ticket')?['Title'], ' (item ID ', string(body('Get_Parent_Ticket')?['ID']), ')</p><p><b>Status:</b> Resolved</p><p><b>Resolved at:</b> ', utcNow(), '</p><p><b>Close code:</b> ', if(outputs('Compose_Any_RITM_Failed'), 'Not Solved (Not Reproducible)', 'Solved Permanently'), '</p><p><b>Resolution summary:</b> All ', string(length(body('Get_Sibling_RITMs')?['value'])), ' RITM(s) reached terminal state. Auto-resolved by SCTASK Orchestrator.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Tickets/DispForm.aspx?ID=', string(body('Get_Parent_Ticket')?['ID']), '\">Open ticket</a></p>')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "description": "Day 4 task 11: ticket resolved notification to caller via Teams Flow bot."
                }
              },
              "runAfter": {
                "Compose_All_RITMs_Closed": [
                  "Succeeded"
                ],
                "Compose_Any_RITM_Failed": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@outputs('Compose_All_RITMs_Closed')",
                      true
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Filter_Closed_RITMs": {
              "runAfter": {
                "Get_Sibling_RITMs": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_Sibling_RITMs')?['value']",
                "where": "@or(or(equals(item()?['RitmState']?['Value'],'Closed Complete'),equals(item()?['RitmState']?['Value'],'Closed Skipped')),or(equals(item()?['RitmState']?['Value'],'Closed Incomplete'),equals(item()?['RitmState']?['Value'],'Cancelled')))"
              }
            },
            "Filter_Failed_RITMs": {
              "runAfter": {
                "Get_Sibling_RITMs": [
                  "Succeeded"
                ]
              },
              "type": "Query",
              "inputs": {
                "from": "@body('Get_Sibling_RITMs')?['value']",
                "where": "@or(equals(item()?['RitmState']?['Value'],'Closed Incomplete'),equals(item()?['RitmState']?['Value'],'Cancelled'))"
              }
            }
          },
          "runAfter": {
            "Compose_All_Closed": [
              "Succeeded"
            ],
            "Compose_Any_Failed": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Compose_All_Closed')",
                  true
                ]
              }
            ]
          },
          "type": "If"
        },
        "Filter_Closed_Tasks": {
          "runAfter": {
            "Get_Sibling_Tasks": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_Sibling_Tasks')?['value']",
            "where": "@or(or(equals(item()?['TaskState']?['Value'],'Closed Complete'),equals(item()?['TaskState']?['Value'],'Closed Skipped')),or(equals(item()?['TaskState']?['Value'],'Closed Incomplete'),equals(item()?['TaskState']?['Value'],'Cancelled')))"
          }
        },
        "Filter_Failed_Tasks": {
          "runAfter": {
            "Get_Sibling_Tasks": [
              "Succeeded"
            ]
          },
          "type": "Query",
          "inputs": {
            "from": "@body('Get_Sibling_Tasks')?['value']",
            "where": "@or(equals(item()?['TaskState']?['Value'],'Closed Incomplete'),equals(item()?['TaskState']?['Value'],'Cancelled'))"
          }
        }
      },
      "runAfter": {
        "Get_Task_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "or": [
          {
            "equals": [
              "@outputs('Get_Task_Fresh')?['body/TaskState/Value']",
              "Closed Complete"
            ]
          },
          {
            "equals": [
              "@outputs('Get_Task_Fresh')?['body/TaskState/Value']",
              "Closed Incomplete"
            ]
          },
          {
            "equals": [
              "@outputs('Get_Task_Fresh')?['body/TaskState/Value']",
              "Closed Skipped"
            ]
          },
          {
            "equals": [
              "@outputs('Get_Task_Fresh')?['body/TaskState/Value']",
              "Cancelled"
            ]
          }
        ]
      },
      "type": "If"
    },
    "Get_Task_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Tasks",
          "id": "@triggerBody()?['taskId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "description": "6.1 SCTASK-Orchestrator. 2026-06-02 poll->push: HTTP Request {taskId}; Get_Task_Fresh live read; called by 3.4 bridge after it writes terminal TaskState. #flowstudio-mcp"
}
