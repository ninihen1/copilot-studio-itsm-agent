{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_a_Ticket_is_Created": {
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "evaluatedRecurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "00000000-0000-0000-0000-000000000009"
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "authentication": "@parameters('$authentication')"
      },
      "conditions": [
        {
          "expression": "@and(not(equals(coalesce(triggerOutputs()?['body/TicketTypeValidated'], false), true)), or(equals(coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], ''), ''), equals(coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], ''), 'NeedsConfirmation'), equals(coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], ''), 'Pending')))"
        }
      ],
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1,
          "maximumWaitingRuns": 50
        }
      }
    }
  },
  "actions": {
    "If_Already_Validated": {
      "actions": {},
      "runAfter": {},
      "else": {
        "actions": {
          "Find_Catalog_Matches": {
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                "table": "Service Catalog",
                "$filter": "@{if(equals(coalesce(triggerOutputs()?['body/SelectedCatalogItem/Id'], 0), 0), if(equals(coalesce(triggerOutputs()?['body/Subcategory/Id'], 0), 0), 'ID eq 0', concat('SubcategoryHint/Id eq ', string(triggerOutputs()?['body/Subcategory/Id']), ' and ItemStatus eq ''active''')), concat('ID eq ', string(triggerOutputs()?['body/SelectedCatalogItem/Id']), ' and ItemStatus eq ''active'''))}",
                "$top": 5
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Find_RITMs_For_Ticket": {
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                "table": "Request Items",
                "$filter": "@{concat('ParentTicket/Id eq ', string(triggerOutputs()?['body/ID']))}",
                "$top": 1
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Find_Provisioning_Jobs_For_Ticket": {
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                "table": "Provisioning Jobs",
                "$filter": "@{concat('ParentTicket/Id eq ', string(triggerOutputs()?['body/ID']))}",
                "$top": 1
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Find_Approvals_For_Ticket": {
            "type": "OpenApiConnection",
            "inputs": {
              "parameters": {
                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                "table": "Approvals",
                "$filter": "@{concat('ParentTicket/Id eq ', string(triggerOutputs()?['body/ID']))}",
                "$top": 1
              },
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItems"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "Compose_CatalogMatchCount": {
            "runAfter": {
              "Find_Catalog_Matches": [
                "Succeeded"
              ]
            },
            "type": "Compose",
            "inputs": "@length(coalesce(body('Find_Catalog_Matches')?['value'], createArray()))"
          },
          "Compose_HasDownstreamWork": {
            "runAfter": {
              "Find_RITMs_For_Ticket": [
                "Succeeded"
              ],
              "Find_Provisioning_Jobs_For_Ticket": [
                "Succeeded"
              ],
              "Find_Approvals_For_Ticket": [
                "Succeeded"
              ]
            },
            "type": "Compose",
            "inputs": "@or(greater(length(coalesce(body('Find_RITMs_For_Ticket')?['value'], createArray())), 0), greater(length(coalesce(body('Find_Provisioning_Jobs_For_Ticket')?['value'], createArray())), 0), greater(length(coalesce(body('Find_Approvals_For_Ticket')?['value'], createArray())), 0), equals(coalesce(triggerOutputs()?['body/MajorIncidentFlag'], false), true))"
          },
          "If_Caller_Confirmed_Override": {
            "actions": {
              "Patch_Caller_Override_Validated": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Tickets",
                    "id": "@triggerOutputs()?['body/ID']",
                    "item/Title": "@triggerOutputs()?['body/Title']",
                    "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                    "item/TicketType/Value": "@triggerOutputs()?['body/TicketType/Value']",
                    "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                    "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                    "item/TicketState/Value": "@triggerOutputs()?['body/TicketState/Value']",
                    "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                    "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                    "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                    "item/TicketTypeValidationStatus/Value": "Validated",
                    "item/TicketTypeValidated": true,
                    "item/TicketTypeValidationReason": "@{concat('Caller confirmed ticket type as ', triggerOutputs()?['body/TicketType/Value'], ' via clarification.')}",
                    "item/SuggestedTicketType/Value": "@triggerOutputs()?['body/TicketType/Value']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            },
            "runAfter": {
              "Compose_CatalogMatchCount": [
                "Succeeded"
              ],
              "Compose_HasDownstreamWork": [
                "Succeeded"
              ]
            },
            "else": {
              "actions": {
                "Switch_TicketType": {
                  "runAfter": {},
                  "cases": {
                    "Case_Request": {
                      "case": "Request",
                      "actions": {
                        "If_Request_Has_One_Catalog_Match": {
                          "actions": {
                            "Patch_Request_Validated": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                  "table": "Tickets",
                                  "id": "@triggerOutputs()?['body/ID']",
                                  "item/Title": "@triggerOutputs()?['body/Title']",
                                  "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                                  "item/TicketType/Value": "Request",
                                  "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                                  "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                                  "item/TicketState/Value": "@triggerOutputs()?['body/TicketState/Value']",
                                  "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                                  "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                                  "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                                  "item/TicketTypeValidationStatus/Value": "Validated",
                                  "item/TicketTypeValidated": true,
                                  "item/TicketTypeValidationReason": "@{concat('Request validated against active catalog item ', first(body('Find_Catalog_Matches')?['value'])?['Title'], '.')}",
                                  "item/SuggestedTicketType/Value": "Request",
                                  "item/SelectedCatalogItem/Id": "@first(body('Find_Catalog_Matches')?['value'])?['ID']"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PatchItem"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Patch_Request_NeedsConfirmation": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "parameters": {
                                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                    "table": "Tickets",
                                    "id": "@triggerOutputs()?['body/ID']",
                                    "item/Title": "@triggerOutputs()?['body/Title']",
                                    "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                                    "item/TicketType/Value": "Request",
                                    "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                                    "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                                    "item/TicketState/Value": "On Hold",
                                    "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                                    "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                                    "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                                    "item/TicketTypeValidationStatus/Value": "NeedsConfirmation",
                                    "item/TicketTypeValidated": false,
                                    "item/TicketTypeValidationReason": "@{if(equals(coalesce(triggerOutputs()?['body/Subcategory/Id'], 0), 0), 'Request has no subcategory.', if(equals(outputs('Compose_CatalogMatchCount'), 0), 'Request has no active Service Catalog match.', 'Request has multiple active Service Catalog matches.'))}",
                                    "item/SuggestedTicketType/Value": "Incident"
                                  },
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PatchItem"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              },
                              "Fire_Clarifier_From_Request_Park": {
                                "runAfter": {
                                  "Patch_Request_NeedsConfirmation": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "Http",
                                "inputs": {
                                  "method": "POST",
                                  "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                                  "headers": {
                                    "Content-Type": "application/json"
                                  },
                                  "body": {
                                    "ticketId": "@triggerOutputs()?['body/ID']",
                                    "callerUpn": "@coalesce(triggerOutputs()?['body/Caller/Email'], '')",
                                    "validationReason": "@{if(equals(coalesce(triggerOutputs()?['body/Subcategory/Id'], 0), 0), 'Request has no subcategory.', if(equals(outputs('Compose_CatalogMatchCount'), 0), 'Request has no active Service Catalog match.', 'Request has multiple active Service Catalog matches.'))}",
                                    "ticketTitle": "@triggerOutputs()?['body/Title']",
                                    "callerName": "@coalesce(triggerOutputs()?['body/Caller/DisplayName'], '')",
                                    "suggestedTicketType": "Incident"
                                  }
                                }
                              }
                            }
                          },
                          "expression": {
                            "equals": [
                              "@outputs('Compose_CatalogMatchCount')",
                              1
                            ]
                          },
                          "type": "If"
                        }
                      }
                    },
                    "Case_Incident": {
                      "case": "Incident",
                      "actions": {
                        "If_Incident_Maps_To_One_Request": {
                          "actions": {
                            "Patch_Incident_Reclassified_To_Request": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "parameters": {
                                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                  "table": "Tickets",
                                  "id": "@triggerOutputs()?['body/ID']",
                                  "item/Title": "@triggerOutputs()?['body/Title']",
                                  "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                                  "item/TicketType/Value": "Request",
                                  "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                                  "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                                  "item/TicketState/Value": "@triggerOutputs()?['body/TicketState/Value']",
                                  "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                                  "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                                  "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                                  "item/WorkNotes": "@{concat(coalesce(triggerOutputs()?['body/WorkNotes'], ''), decodeUriComponent('%0A'), 'Ticket Type Validator: auto-reclassified.')}",
                                  "item/TicketTypeValidationStatus/Value": "Reclassified",
                                  "item/TicketTypeValidated": true,
                                  "item/TicketTypeValidationReason": "Auto-reclassified.",
                                  "item/SuggestedTicketType/Value": "Request",
                                  "item/SelectedCatalogItem/Id": "@first(body('Find_Catalog_Matches')?['value'])?['ID']"
                                },
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PatchItem"
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "If_Incident_Ambiguous_Request": {
                                "actions": {
                                  "Patch_Incident_NeedsConfirmation": {
                                    "type": "OpenApiConnection",
                                    "inputs": {
                                      "parameters": {
                                        "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                        "table": "Tickets",
                                        "id": "@triggerOutputs()?['body/ID']",
                                        "item/Title": "@triggerOutputs()?['body/Title']",
                                        "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                                        "item/TicketType/Value": "Incident",
                                        "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                                        "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                                        "item/TicketState/Value": "On Hold",
                                        "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                                        "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                                        "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                                        "item/TicketTypeValidationStatus/Value": "NeedsConfirmation",
                                        "item/TicketTypeValidated": false,
                                        "item/TicketTypeValidationReason": "Incident subcategory maps to multiple.",
                                        "item/SuggestedTicketType/Value": "Request"
                                      },
                                      "host": {
                                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                        "connectionName": "shared_sharepointonline",
                                        "operationId": "PatchItem"
                                      },
                                      "authentication": "@parameters('$authentication')"
                                    }
                                  },
                                  "Fire_Clarifier_From_Incident_Park": {
                                    "runAfter": {
                                      "Patch_Incident_NeedsConfirmation": [
                                        "Succeeded"
                                      ]
                                    },
                                    "type": "Http",
                                    "inputs": {
                                      "method": "POST",
                                      "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                                      "headers": {
                                        "Content-Type": "application/json"
                                      },
                                      "body": {
                                        "ticketId": "@triggerOutputs()?['body/ID']",
                                        "callerUpn": "@coalesce(triggerOutputs()?['body/Caller/Email'], '')",
                                        "validationReason": "Incident subcategory maps to multiple.",
                                        "ticketTitle": "@triggerOutputs()?['body/Title']",
                                        "callerName": "@coalesce(triggerOutputs()?['body/Caller/DisplayName'], '')",
                                        "suggestedTicketType": "Request"
                                      }
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {
                                    "Patch_Incident_Validated": {
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "parameters": {
                                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                          "table": "Tickets",
                                          "id": "@triggerOutputs()?['body/ID']",
                                          "item/Title": "@triggerOutputs()?['body/Title']",
                                          "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                                          "item/TicketType/Value": "Incident",
                                          "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                                          "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                                          "item/TicketState/Value": "@triggerOutputs()?['body/TicketState/Value']",
                                          "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                                          "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                                          "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                                          "item/TicketTypeValidationStatus/Value": "Validated",
                                          "item/TicketTypeValidated": true,
                                          "item/TicketTypeValidationReason": "Incident validated.",
                                          "item/SuggestedTicketType/Value": "Incident"
                                        },
                                        "host": {
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                          "connectionName": "shared_sharepointonline",
                                          "operationId": "PatchItem"
                                        },
                                        "authentication": "@parameters('$authentication')"
                                      }
                                    }
                                  }
                                },
                                "expression": {
                                  "and": [
                                    {
                                      "greater": [
                                        "@outputs('Compose_CatalogMatchCount')",
                                        1
                                      ]
                                    },
                                    {
                                      "equals": [
                                        "@coalesce(triggerOutputs()?['body/TypeOverrideConfirmed'], false)",
                                        false
                                      ]
                                    }
                                  ]
                                },
                                "type": "If"
                              }
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@outputs('Compose_CatalogMatchCount')",
                                  1
                                ]
                              },
                              {
                                "equals": [
                                  "@outputs('Compose_HasDownstreamWork')",
                                  false
                                ]
                              },
                              {
                                "not": {
                                  "equals": [
                                    "@coalesce(triggerOutputs()?['body/TypeOverrideConfirmed'], false)",
                                    true
                                  ]
                                }
                              }
                            ]
                          },
                          "type": "If"
                        }
                      }
                    }
                  },
                  "default": {
                    "actions": {
                      "Patch_Unsupported_Type_NeedsConfirmation": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "parameters": {
                            "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                            "table": "Tickets",
                            "id": "@triggerOutputs()?['body/ID']",
                            "item/Title": "@triggerOutputs()?['body/Title']",
                            "item/ShortDescription": "@triggerOutputs()?['body/ShortDescription']",
                            "item/TicketType/Value": "@triggerOutputs()?['body/TicketType/Value']",
                            "item/CategoryRef/Id": "@triggerOutputs()?['body/CategoryRef/Id']",
                            "item/Caller/Claims": "@triggerOutputs()?['body/Caller/Claims']",
                            "item/TicketState/Value": "On Hold",
                            "item/Impact/Value": "@triggerOutputs()?['body/Impact/Value']",
                            "item/Urgency/Value": "@triggerOutputs()?['body/Urgency/Value']",
                            "item/ConfidentialityLevel/Value": "@coalesce(triggerOutputs()?['body/ConfidentialityLevel/Value'], 'Public')",
                            "item/TicketTypeValidationStatus/Value": "NeedsConfirmation",
                            "item/TicketTypeValidated": false,
                            "item/TicketTypeValidationReason": "Validator handles Incident and Request only."
                          },
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "authentication": "@parameters('$authentication')"
                        }
                      },
                      "Fire_Clarifier_From_Unsupported_Park": {
                        "runAfter": {
                          "Patch_Unsupported_Type_NeedsConfirmation": [
                            "Succeeded"
                          ]
                        },
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                          "headers": {
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "ticketId": "@triggerOutputs()?['body/ID']",
                            "callerUpn": "@coalesce(triggerOutputs()?['body/Caller/Email'], '')",
                            "validationReason": "Validator handles Incident and Request only.",
                            "ticketTitle": "@triggerOutputs()?['body/Title']",
                            "callerName": "@coalesce(triggerOutputs()?['body/Caller/DisplayName'], '')"
                          }
                        }
                      }
                    }
                  },
                  "expression": "@triggerOutputs()?['body/TicketType/Value']",
                  "type": "Switch"
                }
              }
            },
            "expression": {
              "equals": [
                "@coalesce(triggerOutputs()?['body/TypeOverrideConfirmed'], false)",
                true
              ]
            },
            "type": "If"
          },
          "Get_Ticket_AfterValidation": {
            "runAfter": {
              "If_Caller_Confirmed_Override": [
                "Succeeded"
              ]
            },
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                "connectionName": "shared_sharepointonline",
                "operationId": "GetItem"
              },
              "parameters": {
                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                "table": "Tickets",
                "id": "@triggerOutputs()?['body/ID']"
              },
              "authentication": "@parameters('$authentication')"
            }
          },
          "If_Validated_Fanout": {
            "actions": {
              "Switch_Lane": {
                "runAfter": {},
                "cases": {
                  "Req": {
                    "case": "Request",
                    "actions": {
                      "Call_RITM_Generator": {
                        "runAfter": {},
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                          "headers": {
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "ticketId": "@triggerOutputs()?['body/ID']"
                          }
                        }
                      }
                    }
                  }
                },
                "default": {
                  "actions": {
                    "Call_Triage": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "ticketId": "@triggerOutputs()?['body/ID']"
                        }
                      }
                    },
                    "Call_Major_Incident": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "ticketId": "@triggerOutputs()?['body/ID']"
                        }
                      }
                    }
                  }
                },
                "expression": "@outputs('Get_Ticket_AfterValidation')?['body/TicketType/Value']",
                "type": "Switch"
              }
            },
            "runAfter": {
              "Get_Ticket_AfterValidation": [
                "Succeeded"
              ]
            },
            "expression": {
              "and": [
                {
                  "not": {
                    "equals": [
                      "@coalesce(outputs('Get_Ticket_AfterValidation')?['body/TicketTypeValidationStatus/Value'],'')",
                      "NeedsConfirmation"
                    ]
                  }
                },
                {
                  "not": {
                    "equals": [
                      "@coalesce(outputs('Get_Ticket_AfterValidation')?['body/TicketTypeValidationStatus/Value'],'')",
                      "Pending"
                    ]
                  }
                },
                {
                  "not": {
                    "equals": [
                      "@coalesce(outputs('Get_Ticket_AfterValidation')?['body/TicketTypeValidationStatus/Value'],'')",
                      ""
                    ]
                  }
                }
              ]
            },
            "type": "If"
          }
        }
      },
      "expression": {
        "or": [
          {
            "equals": [
              "@coalesce(triggerOutputs()?['body/TicketTypeValidated'], false)",
              true
            ]
          },
          {
            "equals": [
              "@coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], '')",
              "Validated"
            ]
          },
          {
            "equals": [
              "@coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], '')",
              "Reclassified"
            ]
          },
          {
            "equals": [
              "@coalesce(triggerOutputs()?['body/TicketTypeValidationStatus/Value'], '')",
              "NeedsConfirmation"
            ]
          }
        ]
      },
      "type": "If"
    }
  },
  "description": "1.1 Ticket-Type-Validator (front gate). 2026-06-02: after validation, re-reads ticket and fans out by type — Request->2.2 RITM-Gen, Incident->2.1 Triage + X1 Major-Incident (skips parked/NeedsConfirmation). Trigger stays the Tickets watcher (front door). #flowstudio-mcp"
}
