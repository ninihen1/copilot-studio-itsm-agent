{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "taskId"
          ],
          "properties": {
            "taskId": {
              "type": "integer"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "If_Task_Has_JobType": {
      "actions": {
        "Get_Parent_RITM": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Request Items",
              "id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Parent_Ticket": {
          "runAfter": {
            "Get_Parent_RITM": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tickets",
              "id": "@body('Get_Parent_RITM')?['ParentTicket']?['Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Parse_RITM_Variables": {
          "runAfter": {
            "Get_Parent_Ticket": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(and(startsWith(trim(coalesce(body('Get_Parent_RITM')?['Variables'], '')), '{'), endsWith(trim(coalesce(body('Get_Parent_RITM')?['Variables'], '')), '}')), json(body('Get_Parent_RITM')?['Variables']), json('{}'))"
        },
        "If_Groups_AddMember_Missing_GroupId": {
          "actions": {
            "Patch_SCTASK_Failed_Missing_GroupId": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Tasks",
                  "id": "@outputs('Get_Task_Fresh')?['body/ID']",
                  "item/Title": "@outputs('Get_Task_Fresh')?['body/Title']",
                  "item/TaskNumber": "@outputs('Get_Task_Fresh')?['body/TaskNumber']",
                  "item/ParentRitm/Id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']",
                  "item/TaskState/Value": "Closed Incomplete",
                  "item/ShortDescription": "@outputs('Get_Task_Fresh')?['body/ShortDescription']",
                  "item/OpenedDate": "@outputs('Get_Task_Fresh')?['body/OpenedDate']",
                  "item/ClosedDate": "@utcNow()",
                  "item/WorkNotes": "@{concat('SCTASK-PJ bridge failed fast: groups.addMember requires a validated non-empty RITM.Variables.groupId. RITM Variables: ', coalesce(body('Get_Parent_RITM')?['Variables'], '(empty)'))}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Terminate_Missing_GroupId": {
              "runAfter": {
                "Patch_SCTASK_Failed_Missing_GroupId": [
                  "Succeeded"
                ]
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "runAfter": {
            "Parse_RITM_Variables": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Get_Task_Fresh')?['body/JobType']",
                  "groups.addMember"
                ]
              },
              {
                "equals": [
                  "@trim(coalesce(outputs('Parse_RITM_Variables')?['groupId'], ''))",
                  ""
                ]
              }
            ]
          },
          "type": "If"
        },
        "Compose_PJ_Number": {
          "runAfter": {
            "If_Groups_AddMember_Missing_GroupId": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@{concat('PJ-', formatDateTime(utcNow(),'yyMMddHHmmss'), '-', outputs('Get_Task_Fresh')?['body/ID'])}"
        },
        "Compose_TargetJson": {
          "runAfter": {
            "Compose_PJ_Number": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": {
            "type": "user",
            "upn": "@coalesce(outputs('Parse_RITM_Variables')?['userPrincipalName'], outputs('Parse_RITM_Variables')?['userUpn'], last(split(coalesce(body('Get_Parent_RITM')?['RequestedFor']?['Claims'], body('Get_Parent_Ticket')?['Caller']?['Claims'], '|'), '|')))",
            "id": "@coalesce(outputs('Parse_RITM_Variables')?['groupId'], outputs('Parse_RITM_Variables')?['teamId'], outputs('Parse_RITM_Variables')?['siteId'], '')"
          }
        },
        "Compose_IdempotencyKey": {
          "runAfter": {
            "Compose_TargetJson": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@{concat('SCTASK-', outputs('Get_Task_Fresh')?['body/TaskNumber'], '-', outputs('Get_Task_Fresh')?['body/JobType'])}"
        },
        "Compose_CorrelationId": {
          "runAfter": {
            "Compose_IdempotencyKey": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@guid()"
        },
        "Create_PJ": {
          "runAfter": {
            "Compose_CorrelationId": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "item/Title": "@outputs('Compose_PJ_Number')",
              "item/JobType": "@outputs('Get_Task_Fresh')?['body/JobType']",
              "item/ParentTicket/Id": "@body('Get_Parent_Ticket')?['ID']",
              "item/JobStatus/Value": "AwaitingApproval",
              "item/CallerUpn": "@last(split(coalesce(body('Get_Parent_Ticket')?['Caller']?['Email'], body('Get_Parent_Ticket')?['Caller']?['Claims'], ''), '|'))",
              "item/TargetJson": "@string(outputs('Compose_TargetJson'))",
              "item/ArgsJson": "@string(outputs('Parse_RITM_Variables'))",
              "item/IdempotencyKey": "@outputs('Compose_IdempotencyKey')",
              "item/CorrelationId": "@outputs('Compose_CorrelationId')",
              "item/Rationale": "@{concat('Auto-created by SCTASK-PJ bridge from SCTASK ', outputs('Get_Task_Fresh')?['body/TaskNumber'], ' under RITM ', body('Get_Parent_RITM')?['RitmNumber'], '. Approval inherited from parent RITM.')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Call_Dispatcher": {
          "runAfter": {
            "Create_PJ": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://REDACTED-FLOW-TRIGGER-URL",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "pjId": "@body('Create_PJ')?['ID']",
              "idempotencyKey": "@outputs('Compose_IdempotencyKey')",
              "callerUpn": "@last(split(coalesce(body('Get_Parent_Ticket')?['Caller']?['Email'], body('Get_Parent_Ticket')?['Caller']?['Claims'], ''), '|'))",
              "approverUpn": "catherine.han@flowstudio.app",
              "approvalSessionId": "@{concat('RITM-', body('Get_Parent_RITM')?['RitmNumber'])}",
              "jobType": "@outputs('Get_Task_Fresh')?['body/JobType']",
              "correlationId": "@outputs('Compose_CorrelationId')"
            }
          }
        },
        "Patch_SCTASK_Linked": {
          "runAfter": {
            "Call_Dispatcher": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tasks",
              "id": "@outputs('Get_Task_Fresh')?['body/ID']",
              "item/Title": "@outputs('Get_Task_Fresh')?['body/Title']",
              "item/TaskNumber": "@outputs('Get_Task_Fresh')?['body/TaskNumber']",
              "item/ParentRitm/Id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']",
              "item/TaskState/Value": "In Progress",
              "item/ShortDescription": "@outputs('Get_Task_Fresh')?['body/ShortDescription']",
              "item/OpenedDate": "@outputs('Get_Task_Fresh')?['body/OpenedDate']",
              "item/LinkedJobId": "@body('Create_PJ')?['Title']",
              "item/WorkNotes": "@{concat('Auto-bridged to PJ ', body('Create_PJ')?['Title'], ' (jobType=', outputs('Get_Task_Fresh')?['body/JobType'], '). Dispatcher response: ', string(body('Call_Dispatcher')), '. Awaiting executor pickup.')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Watch_PJ_For_Terminal_State": {
          "actions": {
            "Delay_30s": {
              "runAfter": {},
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 30,
                  "unit": "Second"
                }
              }
            },
            "Get_PJ_Status": {
              "runAfter": {
                "Delay_30s": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Provisioning Jobs",
                  "id": "@body('Create_PJ')?['ID']"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Patch_SCTASK_Linked": [
              "Succeeded"
            ]
          },
          "expression": "@or(equals(coalesce(body('Get_PJ_Status')?['JobStatus']?['Value'], 'Dispatched'), 'Succeeded'), equals(coalesce(body('Get_PJ_Status')?['JobStatus']?['Value'], 'Dispatched'), 'Failed'))",
          "limit": {
            "count": 60,
            "timeout": "PT30M"
          },
          "type": "Until"
        },
        "Patch_SCTASK_Final_State": {
          "runAfter": {
            "Watch_PJ_For_Terminal_State": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tasks",
              "id": "@outputs('Get_Task_Fresh')?['body/ID']",
              "item/Title": "@outputs('Get_Task_Fresh')?['body/Title']",
              "item/TaskNumber": "@outputs('Get_Task_Fresh')?['body/TaskNumber']",
              "item/ParentRitm/Id": "@outputs('Get_Task_Fresh')?['body/ParentRitm/Id']",
              "item/TaskState/Value": "@if(equals(body('Get_PJ_Status')?['JobStatus']?['Value'], 'Succeeded'), 'Closed Complete', 'Closed Incomplete')",
              "item/ShortDescription": "@outputs('Get_Task_Fresh')?['body/ShortDescription']",
              "item/OpenedDate": "@outputs('Get_Task_Fresh')?['body/OpenedDate']",
              "item/ClosedDate": "@utcNow()",
              "item/WorkNotes": "@{concat('PJ ', body('Create_PJ')?['Title'], ' reached terminal state: ', body('Get_PJ_Status')?['JobStatus']?['Value'], '. Closing SCTASK accordingly.')}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Call_Orchestrator_On_Task_Done": {
          "runAfter": {
            "Patch_SCTASK_Final_State": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://REDACTED-FLOW-TRIGGER-URL",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "taskId": "@outputs('Get_Task_Fresh')?['body/ID']"
            }
          }
        }
      },
      "runAfter": {
        "Get_Task_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@coalesce(outputs('Get_Task_Fresh')?['body/JobType'], '')",
                ""
              ]
            }
          },
          {
            "contains": [
              "@coalesce(outputs('Get_Task_Fresh')?['body/JobType'], '')",
              "."
            ]
          },
          {
            "equals": [
              "@coalesce(outputs('Get_Task_Fresh')?['body/LinkedJobId'], '')",
              ""
            ]
          }
        ]
      },
      "type": "If"
    },
    "Get_Task_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Tasks",
          "id": "@triggerBody()?['taskId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "description": "3.4-bridge. 2026-06-02 poll->push: HTTP Request {taskId}; Get_Task_Fresh live read. #flowstudio-mcp"
}
