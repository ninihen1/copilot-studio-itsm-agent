{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "ticketId"
          ],
          "properties": {
            "ticketId": {
              "type": "integer"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "If_TicketType_is_Request": {
      "actions": {
        "Get_Existing_RITMs_For_Ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Request Items",
              "$filter": "@{concat('ParentTicketId eq ', string(outputs('Get_Ticket_Fresh')?['body/ID']))}",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Idempotency guard: do not create another RITM for an already-generated request."
        },
        "Get_Existing_PJs": {
          "runAfter": {
            "Get_Existing_RITMs_For_Ticket": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "$filter": "@{concat('ParentTicketId eq ', string(outputs('Get_Ticket_Fresh')?['body/ID']))}",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "description": "Dedup guard: skip RITM creation if the agent/Triage-Orchestrator path already provisioned this ticket (a Provisioning Job already exists). Prevents the double-pipeline case where an Incident is agent-provisioned then reclassified to Request."
        },
        "Find_Catalog_Item_By_Subcategory": {
          "runAfter": {
            "Get_Existing_PJs": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Service Catalog",
              "$filter": "@{if(equals(coalesce(outputs('Get_Ticket_Fresh')?['body/SelectedCatalogItem/Id'], 0), 0), concat('SubcategoryHint/Id eq ', coalesce(string(outputs('Get_Ticket_Fresh')?['body/Subcategory/Id']), '0'), ' and ItemStatus eq ''active'''), concat('ID eq ', string(outputs('Get_Ticket_Fresh')?['body/SelectedCatalogItem/Id']), ' and ItemStatus eq ''active'''))}",
              "$top": 5
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_Match_Found": {
          "actions": {
            "Compose_Catalog_Item": {
              "runAfter": {},
              "type": "Compose",
              "inputs": "@first(body('Find_Catalog_Item_By_Subcategory')?['value'])"
            },
            "Compose_Ritm_Number": {
              "runAfter": {
                "Compose_Catalog_Item": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": "@{concat('RITM', formatDateTime(utcNow(),'yyMMddHHmm'), substring(replace(guid(),'-',''),0,4))}"
            },
            "Create_RITM": {
              "runAfter": {
                "Compose_Ritm_Number": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "item/Title": "@outputs('Compose_Ritm_Number')",
                  "item/RitmNumber": "@outputs('Compose_Ritm_Number')",
                  "item/ParentTicket/Id": "@outputs('Get_Ticket_Fresh')?['body/ID']",
                  "item/CatalogItem/Id": "@outputs('Compose_Catalog_Item')?['ID']",
                  "item/RequestedFor/Claims": "@coalesce(outputs('Get_Ticket_Fresh')?['body/RequestedForUser/Claims'], outputs('Get_Ticket_Fresh')?['body/Caller/Claims'])",
                  "item/RitmState/Value": "Pending Validation",
                  "item/Variables": "@coalesce(outputs('Get_Ticket_Fresh')?['body/RequestPayloadJson'], outputs('Get_Ticket_Fresh')?['body/Description'])",
                  "item/OpenedDate": "@utcNow()",
                  "item/ConfidentialityLevel/Value": "@coalesce(outputs('Get_Ticket_Fresh')?['body/ConfidentialityLevel/Value'], 'Public')",
                  "item/Cost": "@outputs('Compose_Catalog_Item')?['Cost']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Patch_Ticket_AwaitingApproval": {
              "runAfter": {
                "Create_RITM": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Tickets",
                  "id": "@outputs('Get_Ticket_Fresh')?['body/ID']",
                  "item/Title": "@outputs('Get_Ticket_Fresh')?['body/Title']",
                  "item/TicketType/Value": "@outputs('Get_Ticket_Fresh')?['body/TicketType/Value']",
                  "item/CategoryRef/Id": "@outputs('Get_Ticket_Fresh')?['body/CategoryRef/Id']",
                  "item/Caller/Claims": "@outputs('Get_Ticket_Fresh')?['body/Caller/Claims']",
                  "item/TicketState/Value": "In Progress",
                  "item/Impact/Value": "@outputs('Get_Ticket_Fresh')?['body/Impact/Value']",
                  "item/Urgency/Value": "@outputs('Get_Ticket_Fresh')?['body/Urgency/Value']",
                  "item/ShortDescription": "@outputs('Get_Ticket_Fresh')?['body/ShortDescription']",
                  "item/ConfidentialityLevel/Value": "@outputs('Get_Ticket_Fresh')?['body/ConfidentialityLevel/Value']",
                  "item/WorkNotes": "@{concat('RITM ', outputs('Compose_Ritm_Number'), ' generated from catalog item ', outputs('Compose_Catalog_Item')?['Title'], '. Awaiting AI + deterministic validation before approval and task creation.')}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Call_Validation": {
              "runAfter": {
                "Create_RITM": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "ritmId": "@outputs('Create_RITM')?['body/ID']"
                }
              }
            }
          },
          "runAfter": {
            "Find_Catalog_Item_By_Subcategory": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Patch_Ticket_NoMatch": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Tickets",
                    "id": "@outputs('Get_Ticket_Fresh')?['body/ID']",
                    "item/Title": "@outputs('Get_Ticket_Fresh')?['body/Title']",
                    "item/TicketType/Value": "@outputs('Get_Ticket_Fresh')?['body/TicketType/Value']",
                    "item/CategoryRef/Id": "@outputs('Get_Ticket_Fresh')?['body/CategoryRef/Id']",
                    "item/Caller/Claims": "@outputs('Get_Ticket_Fresh')?['body/Caller/Claims']",
                    "item/TicketState/Value": "@outputs('Get_Ticket_Fresh')?['body/TicketState/Value']",
                    "item/Impact/Value": "@outputs('Get_Ticket_Fresh')?['body/Impact/Value']",
                    "item/Urgency/Value": "@outputs('Get_Ticket_Fresh')?['body/Urgency/Value']",
                    "item/ShortDescription": "@outputs('Get_Ticket_Fresh')?['body/ShortDescription']",
                    "item/ConfidentialityLevel/Value": "@outputs('Get_Ticket_Fresh')?['body/ConfidentialityLevel/Value']",
                    "item/WorkNotes": "RITM Generator skipped: no matching Service Catalog item, or this ticket was already provisioned by the agent path (existing Provisioning Job). No RITM created."
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(coalesce(body('Find_Catalog_Item_By_Subcategory')?['value'], createArray()))",
                  0
                ]
              },
              {
                "equals": [
                  "@length(coalesce(body('Get_Existing_RITMs_For_Ticket')?['value'], createArray()))",
                  0
                ]
              },
              {
                "equals": [
                  "@length(coalesce(body('Get_Existing_PJs')?['value'], createArray()))",
                  0
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {
        "Get_Ticket_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_Ticket_Fresh')?['body/TicketType/Value']",
              "Request"
            ]
          }
        ]
      },
      "type": "If"
    },
    "Get_Ticket_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Tickets",
          "id": "@triggerBody()?['ticketId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "description": "2.2 RITM-Generator. 2026-06-02: after Create_RITM, HTTP-calls 3.2 RITM-Validation {ritmId}. #flowstudio-mcp"
}
