{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "ritmId"
          ],
          "properties": {
            "ritmId": {
              "type": "integer"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "If_RITM_Pending_Validation": {
      "actions": {
        "Get_Parent_Ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tickets",
              "id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Catalog_Item": {
          "runAfter": {
            "Get_Parent_Ticket": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Service Catalog",
              "id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_Structured_Payload": {
          "actions": {
            "Parse_Structured_Payload": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@outputs('Get_RITM_Fresh')?['body/Variables']",
                "schema": {
                  "type": "object",
                  "properties": {
                    "skuPartNumber": {},
                    "skuId": {},
                    "action": {},
                    "requestedFor": {},
                    "justification": {},
                    "groupId": {},
                    "groupName": {}
                  }
                }
              }
            },
            "Compose_Structured_Validated": {
              "runAfter": {
                "Parse_Structured_Payload": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "triageStatus": "Validated",
                "jobType": "@coalesce(body('Get_Catalog_Item')?['JobType'], '')",
                "action": "@coalesce(body('Parse_Structured_Payload')?['action'], 'assign')",
                "skuPartNumber": "@coalesce(body('Parse_Structured_Payload')?['skuPartNumber'], '')",
                "skuId": "@coalesce(body('Parse_Structured_Payload')?['skuId'], '')",
                "groupId": "@coalesce(body('Parse_Structured_Payload')?['groupId'], '')",
                "groupName": "@coalesce(body('Parse_Structured_Payload')?['groupName'], '')",
                "requestedFor": "@coalesce(body('Parse_Structured_Payload')?['requestedFor'], outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], '')",
                "justification": "@coalesce(body('Parse_Structured_Payload')?['justification'], '')",
                "validatedAt": "@utcNow()",
                "validationSource": "Structured portal payload (no AI, no fuzzy match)"
              }
            },
            "Patch_RITM_Pending_Approval_Structured": {
              "runAfter": {
                "Compose_Structured_Validated": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                  "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                  "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                  "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                  "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                  "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                  "item/RitmState/Value": "Pending Approval",
                  "item/Variables": "@string(outputs('Compose_Structured_Validated'))",
                  "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                  "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                  "item/WorkNotes": "@{concat('RITM validation passed via structured portal payload (JobType ', coalesce(body('Get_Catalog_Item')?['JobType'], 'n/a'), '). No AI extraction or fuzzy matching needed. Released to approval; approver reviews seats and cost.')}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Call_Approval_Structured": {
              "runAfter": {
                "Patch_RITM_Pending_Approval_Structured": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "ritmId": "@triggerBody()?['ritmId']"
                }
              }
            }
          },
          "runAfter": {
            "Get_Catalog_Item": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "AI_Builder_Create_Text_With_GPT": {
                "runAfter": {},
                "metadata": {
                  "flowSystemMetadata": {
                    "portalOperationId": "PredictV2",
                    "portalOperationGroup": "aibuilder",
                    "portalOperationApiDisplayNameOverride": "AI Builder",
                    "portalOperationIconOverride": "https://content.powerapps.com/resource/makerx/static/pauto/images/designeroperations/aibuilderIcon2026.8e878397.png",
                    "portalOperationBrandColorOverride": "#0A76C4",
                    "portalOperationApiTierOverride": "Standard"
                  },
                  "operationMetadataId": "ritm-validation-triage-ai-builder-gpt"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "PredictV2"
                  },
                  "parameters": {
                    "recordId": "00000000-0000-0000-0000-000000000003",
                    "item/requestv2/JobType": "@{coalesce(body('Get_Catalog_Item')?['JobType'], '')}",
                    "item/requestv2/CatalogItem": "@{concat(coalesce(body('Get_Catalog_Item')?['ItemName'], ''), ' - ', coalesce(body('Get_Catalog_Item')?['Description'], ''))}",
                    "item/requestv2/InputSchema": "@{coalesce(body('Get_Catalog_Item')?['InputSchema'], '')}",
                    "item/requestv2/RequestedFor": "@{last(split(coalesce(outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], ''), '|'))}",
                    "item/requestv2/RequestText": "@{coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], body('Get_Parent_Ticket')?['Description'], body('Get_Parent_Ticket')?['ShortDescription'], '')}"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Patch_RITM_AI_Down": {
                "runAfter": {
                  "AI_Builder_Create_Text_With_GPT": [
                    "Failed",
                    "TimedOut"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Request Items",
                    "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                    "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                    "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                    "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                    "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                    "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                    "item/RitmState/Value": "On Hold",
                    "item/Variables": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')",
                    "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                    "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                    "item/WorkNotes": "@{concat('Validation triage could not run: AI Builder text extraction failed (model unavailable). Auto-placed On Hold for manual validation. RITM ', outputs('Get_RITM_Fresh')?['body/RitmNumber'], ' at ', utcNow(), '.')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Notify_Catherine_AI_Down": {
                "runAfter": {
                  "Patch_RITM_AI_Down": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "connectionName": "shared_teams",
                    "operationId": "PostMessageToConversation"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "itsm-admin@contoso.com",
                    "body/messageBody": "@{concat('<h2>RITM validation could not run</h2><p>The AI extraction step failed (model unavailable), so <b>', outputs('Get_RITM_Fresh')?['body/RitmNumber'], '</b> (item ID ', string(outputs('Get_RITM_Fresh')?['body/ID']), ') was placed <b>On Hold</b> for manual validation.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(outputs('Get_RITM_Fresh')?['body/ID']), '\">Open request item</a></p>')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Parse_AI_Intent": {
                "runAfter": {
                  "AI_Builder_Create_Text_With_GPT": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@coalesce(outputs('AI_Builder_Create_Text_With_GPT')?['body/responsev2/predictionOutput/text'], outputs('AI_Builder_Create_Text_With_GPT')?['body/responsev2/predictionOutput/Text'])",
                  "schema": {
                    "type": "object",
                    "required": [
                      "jobType",
                      "confidence"
                    ],
                    "properties": {
                      "jobType": {
                        "type": "string"
                      },
                      "targetUserUpn": {
                        "type": "string"
                      },
                      "resourceType": {
                        "type": "string"
                      },
                      "resourceName": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "high",
                          "medium",
                          "low"
                        ]
                      },
                      "missing": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "summary": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "Compose_Lookup_Keys": {
                "runAfter": {
                  "Parse_AI_Intent": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": {
                  "userEmail": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                  "groupName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                  "resourceType": "@toLower(coalesce(body('Parse_AI_Intent')?['resourceType'], ''))"
                }
              },
              "Get_KV_Secret": {
                "runAfter": {
                  "Parse_AI_Intent": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                    "connectionName": "shared_keyvault",
                    "operationId": "GetSecret"
                  },
                  "parameters": {
                    "secretName": "SP-IT-Groups-ClientSecret"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Get_Graph_Token": {
                "runAfter": {
                  "Get_KV_Secret": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000001/oauth2/v2.0/token",
                  "headers": {
                    "Content-Type": "application/x-www-form-urlencoded"
                  },
                  "body": "@{concat('grant_type=client_credentials&client_id=00000000-0000-0000-0000-000000000002&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&client_secret=', encodeUriComponent(body('Get_KV_Secret')?['value']))}"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Parse_Graph_Token": {
                "runAfter": {
                  "Get_Graph_Token": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@body('Get_Graph_Token')",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "access_token": {
                        "type": "string"
                      },
                      "token_type": {
                        "type": "string"
                      },
                      "expires_in": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs"
                    ]
                  }
                }
              },
              "Graph_Find_Users": {
                "runAfter": {
                  "Parse_Graph_Token": [
                    "Succeeded"
                  ],
                  "Compose_Lookup_Keys": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{if(contains(coalesce(outputs('Compose_Lookup_Keys')?['userEmail'], ''), '@'), concat('https://graph.microsoft.com/v1.0/users?$filter=', encodeUriComponent(concat('userPrincipalName eq ''', outputs('Compose_Lookup_Keys')?['userEmail'], ''' or mail eq ''', outputs('Compose_Lookup_Keys')?['userEmail'], '''')), '&$select=id,displayName,userPrincipalName,mail&$top=2'), concat('https://graph.microsoft.com/v1.0/users?$search=\"displayName:', encodeUriComponent(if(empty(trim(coalesce(outputs('Compose_Lookup_Keys')?['userEmail'], ''))), 'zzzz-no-such-user-zzzz', outputs('Compose_Lookup_Keys')?['userEmail'])), '\"&$select=id,displayName,userPrincipalName,mail&$top=2'))}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', body('Parse_Graph_Token')?['access_token'])}",
                    "ConsistencyLevel": "eventual"
                  }
                }
              },
              "Graph_Find_Groups": {
                "runAfter": {
                  "Graph_Find_Users": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat('https://graph.microsoft.com/v1.0/groups?$search=\"displayName:', encodeUriComponent(if(empty(trim(coalesce(outputs('Compose_Lookup_Keys')?['groupName'], ''))), 'zzzz-no-such-group-zzzz', outputs('Compose_Lookup_Keys')?['groupName'])), '\"&$select=id,displayName,mail&$top=2')}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', body('Parse_Graph_Token')?['access_token'])}",
                    "ConsistencyLevel": "eventual"
                  }
                }
              },
              "If_Exact_Validated_Match": {
                "actions": {
                  "Compose_Validated_Variables": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": {
                      "triageStatus": "Validated",
                      "jobType": "@coalesce(body('Parse_AI_Intent')?['jobType'], '')",
                      "targetUserUpn": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                      "userId": "@first(body('Graph_Find_Users')?['value'])?['id']",
                      "userPrincipalName": "@first(body('Graph_Find_Users')?['value'])?['userPrincipalName']",
                      "resourceType": "@coalesce(body('Parse_AI_Intent')?['resourceType'], '')",
                      "resourceName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                      "groupId": "@first(body('Graph_Find_Groups')?['value'])?['id']",
                      "groupName": "@first(body('Graph_Find_Groups')?['value'])?['displayName']",
                      "confidence": "@body('Parse_AI_Intent')?['confidence']",
                      "summary": "@coalesce(body('Parse_AI_Intent')?['summary'], '')",
                      "validatedAt": "@utcNow()",
                      "validationSource": "AI extraction (JobType-aware) plus Microsoft Graph resolution",
                      "originalText": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')"
                    }
                  },
                  "Patch_RITM_Pending_Approval": {
                    "runAfter": {
                      "Compose_Validated_Variables": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                        "table": "Request Items",
                        "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                        "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                        "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                        "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                        "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                        "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                        "item/RitmState/Value": "Pending Approval",
                        "item/Variables": "@string(outputs('Compose_Validated_Variables'))",
                        "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                        "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                        "item/WorkNotes": "@{concat('RITM validation passed (JobType ', coalesce(body('Parse_AI_Intent')?['jobType'], 'n/a'), '): ', coalesce(body('Parse_AI_Intent')?['summary'], ''), ' Released to approval.')}"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Call_Approval_AI": {
                    "runAfter": {
                      "Patch_RITM_Pending_Approval": [
                        "Succeeded"
                      ]
                    },
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "https://REDACTED-FLOW-TRIGGER-URL",
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "ritmId": "@triggerBody()?['ritmId']"
                      }
                    }
                  }
                },
                "runAfter": {
                  "Graph_Find_Groups": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Compose_Hold_Variables": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": {
                        "triageStatus": "NeedsClarification",
                        "reason": "AI confidence was too low, a required field was missing, or the target user/group could not be resolved.",
                        "jobType": "@coalesce(body('Parse_AI_Intent')?['jobType'], '')",
                        "targetUserUpn": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                        "resourceType": "@coalesce(body('Parse_AI_Intent')?['resourceType'], '')",
                        "resourceName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                        "confidence": "@coalesce(body('Parse_AI_Intent')?['confidence'], '')",
                        "missing": "@coalesce(body('Parse_AI_Intent')?['missing'], createArray())",
                        "summary": "@coalesce(body('Parse_AI_Intent')?['summary'], '')",
                        "userMatchCount": "@length(coalesce(body('Graph_Find_Users')?['value'], createArray()))",
                        "groupMatchCount": "@length(coalesce(body('Graph_Find_Groups')?['value'], createArray()))",
                        "originalText": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')"
                      }
                    },
                    "Patch_RITM_On_Hold": {
                      "runAfter": {
                        "Compose_Hold_Variables": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                          "table": "Request Items",
                          "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                          "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                          "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                          "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                          "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                          "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                          "item/RitmState/Value": "On Hold",
                          "item/Variables": "@string(outputs('Compose_Hold_Variables'))",
                          "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                          "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                          "item/WorkNotes": "@{concat('RITM validation triage put this request on hold. Catherine must clarify before approval. Details: ', string(outputs('Compose_Hold_Variables')))}"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Notify_Catherine_Clarification": {
                      "runAfter": {
                        "Patch_RITM_On_Hold": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                          "connectionName": "shared_teams",
                          "operationId": "PostMessageToConversation"
                        },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "body/recipient": "itsm-admin@contoso.com",
                          "body/messageBody": "@{concat('<h2>RITM needs clarification</h2><p><b>RITM:</b> ', outputs('Get_RITM_Fresh')?['body/RitmNumber'], ' (item ID ', string(outputs('Get_RITM_Fresh')?['body/ID']), ')</p><p><b>Operation:</b> ', coalesce(body('Parse_AI_Intent')?['jobType'], 'n/a'), '</p><p><b>Target user:</b> ', coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '(none)'), '</p><p><b>Resource:</b> ', coalesce(body('Parse_AI_Intent')?['resourceName'], '(none)'), '</p><p><b>Confidence:</b> ', coalesce(body('Parse_AI_Intent')?['confidence'], ''), ' &middot; <b>Missing:</b> ', join(coalesce(body('Parse_AI_Intent')?['missing'], createArray()), ', '), '</p><p>', coalesce(body('Parse_AI_Intent')?['summary'], ''), '</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(outputs('Get_RITM_Fresh')?['body/ID']), '\">Open request item</a></p>')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@and(not(equals(toLower(coalesce(body('Parse_AI_Intent')?['confidence'], 'low')), 'low')), equals(length(coalesce(body('Parse_AI_Intent')?['missing'], createArray())), 0), or(empty(coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')), greater(length(coalesce(body('Graph_Find_Users')?['value'], createArray())), 0)), or(not(equals(toLower(coalesce(body('Parse_AI_Intent')?['resourceType'], '')), 'group')), greater(length(coalesce(body('Graph_Find_Groups')?['value'], createArray())), 0)))",
                        true
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@startsWith(trim(coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')), '{')",
                  true
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {
        "Get_RITM_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_RITM_Fresh')?['body/RitmState/Value']",
              "Pending Validation"
            ]
          }
        ]
      },
      "type": "If"
    },
    "Get_RITM_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Request Items",
          "id": "@triggerBody()?['ritmId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "description": "3.2 RITM-Validation. 2026-06-02: on validated (structured OR AI exact-match), HTTP-calls 3.3 RITM-Approval {ritmId}. On Hold/AI-down do not call. #flowstudio-mcp"
}
