{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "ritmId"
          ],
          "properties": {
            "ritmId": {
              "type": "integer"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "Get_RITM_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Request Items",
          "id": "@triggerBody()?['ritmId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "If_RITM_Pending_Validation": {
      "actions": {
        "Get_Parent_Ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tickets",
              "id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Catalog_Item": {
          "runAfter": {
            "Get_Parent_Ticket": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Service Catalog",
              "id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_Structured_Payload": {
          "actions": {
            "Parse_Structured_Payload": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@outputs('Get_RITM_Fresh')?['body/Variables']",
                "schema": {
                  "type": "object",
                  "properties": {
                    "skuPartNumber": {},
                    "skuId": {},
                    "action": {},
                    "requestedFor": {},
                    "justification": {},
                    "groupId": {},
                    "groupName": {}
                  }
                }
              }
            },
            "Compose_Structured_Validated": {
              "runAfter": {
                "Parse_Structured_Payload": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "triageStatus": "Validated",
                "jobType": "@coalesce(body('Get_Catalog_Item')?['JobType'], '')",
                "action": "@coalesce(body('Parse_Structured_Payload')?['action'], 'assign')",
                "skuPartNumber": "@coalesce(body('Parse_Structured_Payload')?['skuPartNumber'], '')",
                "skuId": "@coalesce(body('Parse_Structured_Payload')?['skuId'], '')",
                "groupId": "@coalesce(body('Parse_Structured_Payload')?['groupId'], '')",
                "groupName": "@coalesce(body('Parse_Structured_Payload')?['groupName'], '')",
                "requestedFor": "@coalesce(body('Parse_Structured_Payload')?['requestedFor'], outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], '')",
                "justification": "@coalesce(body('Parse_Structured_Payload')?['justification'], '')",
                "validatedAt": "@utcNow()",
                "validationSource": "Structured portal payload (no AI, no fuzzy match)"
              }
            },
            "Patch_RITM_Pending_Approval_Structured": {
              "runAfter": {
                "Compose_Structured_Validated": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                  "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                  "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                  "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                  "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                  "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                  "item/RitmState/Value": "Pending Approval",
                  "item/Variables": "@string(outputs('Compose_Structured_Validated'))",
                  "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                  "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                  "item/WorkNotes": "@{concat('RITM validation passed via structured portal payload (JobType ', coalesce(body('Get_Catalog_Item')?['JobType'], 'n/a'), '). No AI extraction or fuzzy matching needed. Released to approval; approver reviews seats and cost.')}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Call_Approval_Structured": {
              "runAfter": {
                "Patch_RITM_Pending_Approval_Structured": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "https://00000000000000000000000000000000.b5.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/REDACTED_WORKFLOW_ID/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=REDACTED",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "ritmId": "@triggerBody()?['ritmId']"
                }
              }
            }
          },
          "runAfter": {
            "Get_Catalog_Item": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Compose_TriagePrompt": {
                "runAfter": {},
                "type": "Compose",
                "inputs": "Triage this ticket from the automated intake flow.\n\n[TRIAGE_REQUEST]\nticketId: @{coalesce(outputs('Get_RITM_Fresh')?['body/RitmNumber'], '')}\nticketSpItemId: @{string(outputs('Get_RITM_Fresh')?['body/ID'])}\ncallerUpn: @{last(split(coalesce(outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], ''), '|'))}\ncallerName: @{coalesce(body('Get_Parent_Ticket')?['Caller/DisplayName'], '')}\nshortDescription: @{coalesce(body('Get_Catalog_Item')?['ItemName'], outputs('Get_RITM_Fresh')?['body/Title'], '')}\ndescription: @{coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], body('Get_Parent_Ticket')?['Description'], body('Get_Parent_Ticket')?['ShortDescription'], '')}\nopenedDate: @{coalesce(outputs('Get_RITM_Fresh')?['body/OpenedDate'], '')}\n\nThis is a catalog Request Item (RITM) for '@{coalesce(body('Get_Catalog_Item')?['ItemName'], '')}' (JobType hint: @{coalesce(body('Get_Catalog_Item')?['JobType'], '')}). Classify and propose the privileged action. For any group-membership request, use your FindGroup tool to resolve the group and return the resolved groupId and groupDisplayName in proposedAction.args. Reply with EXACTLY the tagged JSON block and NOTHING ELSE."
              },
              "Execute_Agent_Triage": {
                "runAfter": {
                  "Compose_TriagePrompt": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnectionWebhook",
                "inputs": {
                  "parameters": {
                    "Copilot": "cre79_agent",
                    "body/message": "@{outputs('Compose_TriagePrompt')}"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
                    "connectionName": "shared_microsoftcopilotstudio",
                    "operationId": "ExecuteCopilotAsyncV2"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Patch_RITM_AI_Down": {
                "runAfter": {
                  "Execute_Agent_Triage": [
                    "Failed",
                    "TimedOut"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Request Items",
                    "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                    "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                    "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                    "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                    "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                    "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                    "item/RitmState/Value": "On Hold",
                    "item/Variables": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')",
                    "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                    "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                    "item/WorkNotes": "@{concat('Validation triage could not run: the triage agent call failed or timed out. Auto-placed On Hold for manual validation. RITM ', outputs('Get_RITM_Fresh')?['body/RitmNumber'], ' at ', utcNow(), '.')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Notify_the admin_AI_Down": {
                "runAfter": {
                  "Patch_RITM_AI_Down": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "connectionName": "shared_teams",
                    "operationId": "PostMessageToConversation"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "itsm-admin@contoso.com",
                    "body/messageBody": "@{concat('<h2>RITM validation could not run</h2><p>The triage agent call failed (agent unavailable), so <b>', outputs('Get_RITM_Fresh')?['body/RitmNumber'], '</b> (item ID ', string(outputs('Get_RITM_Fresh')?['body/ID']), ') was placed <b>On Hold</b> for manual validation.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(outputs('Get_RITM_Fresh')?['body/ID']), '\">Open request item</a></p>')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Compose_RawReply": {
                "runAfter": {
                  "Execute_Agent_Triage": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": "@coalesce(outputs('Execute_Agent_Triage')?['body/lastResponse'], '')"
              },
              "Compose_ExtractedBlock": {
                "runAfter": {
                  "Compose_RawReply": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": "@if(and(contains(outputs('Compose_RawReply'), '<<<TRIAGE_BEGIN>>>'), contains(outputs('Compose_RawReply'), '<<<TRIAGE_END>>>')), trim(substring(outputs('Compose_RawReply'), add(indexOf(outputs('Compose_RawReply'), '<<<TRIAGE_BEGIN>>>'), 19), sub(indexOf(outputs('Compose_RawReply'), '<<<TRIAGE_END>>>'), add(indexOf(outputs('Compose_RawReply'), '<<<TRIAGE_BEGIN>>>'), 19)))), '{}')"
              },
              "Parse_Agent_Triage": {
                "runAfter": {
                  "Compose_ExtractedBlock": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@outputs('Compose_ExtractedBlock')",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "outcome": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ticketType": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "callerUpn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "targetUserUpn": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "moreInfoNeeded": {},
                      "proposedAction": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "jobType": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "args": {
                            "type": [
                              "object",
                              "null"
                            ]
                          }
                        }
                      },
                      "confidence": {},
                      "rationale": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              },
              "Compose_Intent_Shim": {
                "runAfter": {
                  "Parse_Agent_Triage": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": {
                  "jobType": "@coalesce(body('Parse_Agent_Triage')?['proposedAction']?['jobType'], '')",
                  "targetUserUpn": "@coalesce(body('Parse_Agent_Triage')?['targetUserUpn'], '')",
                  "resourceType": "@if(startsWith(coalesce(body('Parse_Agent_Triage')?['proposedAction']?['jobType'], ''), 'groups.'), 'group', if(startsWith(coalesce(body('Parse_Agent_Triage')?['proposedAction']?['jobType'], ''), 'licensing.'), 'license', if(startsWith(coalesce(body('Parse_Agent_Triage')?['proposedAction']?['jobType'], ''), 'exchange.'), 'mailbox', if(startsWith(coalesce(body('Parse_Agent_Triage')?['proposedAction']?['jobType'], ''), 'sharepoint.'), 'file', ''))))",
                  "resourceName": "@coalesce(body('Parse_Agent_Triage')?['proposedAction']?['args']?['groupDisplayName'], body('Parse_Agent_Triage')?['proposedAction']?['args']?['groupName'], body('Parse_Agent_Triage')?['proposedAction']?['args']?['skuPartNumber'], body('Parse_Agent_Triage')?['proposedAction']?['args']?['resourceName'], '')",
                  "agentGroupId": "@coalesce(body('Parse_Agent_Triage')?['proposedAction']?['args']?['groupId'], '')",
                  "confidence": "@if(equals(coalesce(body('Parse_Agent_Triage')?['outcome'], ''), 'propose'), 'high', 'low')",
                  "missing": "@if(equals(coalesce(body('Parse_Agent_Triage')?['outcome'], ''), 'stop_and_ask'), createArray(coalesce(body('Parse_Agent_Triage')?['moreInfoNeeded'], 'clarification needed')), json('[]'))",
                  "summary": "@coalesce(body('Parse_Agent_Triage')?['rationale'], '')",
                  "outcome": "@coalesce(body('Parse_Agent_Triage')?['outcome'], '')",
                  "moreInfoNeeded": "@coalesce(body('Parse_Agent_Triage')?['moreInfoNeeded'], '')"
                }
              },
              "Parse_AI_Intent": {
                "runAfter": {
                  "Compose_Intent_Shim": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@outputs('Compose_Intent_Shim')",
                  "schema": {
                    "type": "object",
                    "required": [
                      "jobType",
                      "confidence"
                    ],
                    "properties": {
                      "jobType": {
                        "type": "string"
                      },
                      "targetUserUpn": {
                        "type": "string"
                      },
                      "resourceType": {
                        "type": "string"
                      },
                      "resourceName": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "high",
                          "medium",
                          "low"
                        ]
                      },
                      "missing": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "summary": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "If_Exact_Validated_Match": {
                "actions": {
                  "Compose_Validated_Variables": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": {
                      "triageStatus": "Validated",
                      "jobType": "@coalesce(body('Parse_AI_Intent')?['jobType'], '')",
                      "targetUserUpn": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                      "userPrincipalName": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                      "resourceType": "@coalesce(body('Parse_AI_Intent')?['resourceType'], '')",
                      "resourceName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                      "groupId": "@coalesce(outputs('Compose_Intent_Shim')?['agentGroupId'], '')",
                      "groupName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                      "confidence": "@body('Parse_AI_Intent')?['confidence']",
                      "summary": "@coalesce(body('Parse_AI_Intent')?['summary'], '')",
                      "validatedAt": "@utcNow()",
                      "validationSource": "Triage agent (cre79_agent) + FindGroup; agent-resolved groupId, no flow-side Graph",
                      "originalText": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')"
                    }
                  },
                  "Patch_RITM_Pending_Approval": {
                    "runAfter": {
                      "Compose_Validated_Variables": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                        "table": "Request Items",
                        "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                        "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                        "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                        "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                        "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                        "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                        "item/RitmState/Value": "Pending Approval",
                        "item/Variables": "@string(outputs('Compose_Validated_Variables'))",
                        "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                        "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                        "item/WorkNotes": "@{concat('RITM validation passed (JobType ', coalesce(body('Parse_AI_Intent')?['jobType'], 'n/a'), '): ', coalesce(body('Parse_AI_Intent')?['summary'], ''), ' Released to approval.')}"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  },
                  "Call_Approval_AI": {
                    "runAfter": {
                      "Patch_RITM_Pending_Approval": [
                        "Succeeded"
                      ]
                    },
                    "type": "Http",
                    "inputs": {
                      "method": "POST",
                      "uri": "https://00000000000000000000000000000000.b5.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/REDACTED_WORKFLOW_ID/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=REDACTED",
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "ritmId": "@triggerBody()?['ritmId']"
                      }
                    }
                  }
                },
                "runAfter": {
                  "Parse_AI_Intent": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Compose_Hold_Variables": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": {
                        "triageStatus": "NeedsClarification",
                        "reason": "Agent could not confidently classify, a required field was missing, or the group could not be resolved.",
                        "jobType": "@coalesce(body('Parse_AI_Intent')?['jobType'], '')",
                        "targetUserUpn": "@coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '')",
                        "resourceType": "@coalesce(body('Parse_AI_Intent')?['resourceType'], '')",
                        "resourceName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                        "confidence": "@coalesce(body('Parse_AI_Intent')?['confidence'], '')",
                        "missing": "@coalesce(body('Parse_AI_Intent')?['missing'], json('[]'))",
                        "summary": "@coalesce(body('Parse_AI_Intent')?['summary'], '')",
                        "agentGroupId": "@coalesce(outputs('Compose_Intent_Shim')?['agentGroupId'], '')",
                        "originalText": "@coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')",
                        "outcome": "@coalesce(outputs('Compose_Intent_Shim')?['outcome'], '')"
                      }
                    },
                    "If_Clarify_Else_Handoff": {
                      "actions": {
                        "Patch_RITM_Clarify": {
                          "runAfter": {},
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PatchItem"
                            },
                            "parameters": {
                              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                              "table": "Request Items",
                              "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                              "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                              "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                              "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                              "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                              "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                              "item/RitmState/Value": "On Hold",
                              "item/Variables": "@string(outputs('Compose_Hold_Variables'))",
                              "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                              "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                              "item/WorkNotes": "@{concat('Needs clarification from the requester before it can proceed: ', coalesce(outputs('Compose_Intent_Shim')?['moreInfoNeeded'], 'see request'), '. Awaiting reply; the requester owns the next step.')}"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Create_Clarify_Approval": {
                          "runAfter": {
                            "Patch_RITM_Clarify": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "approvalType": "CustomResponse",
                              "ApprovalCreationInput/responseOptions": [
                                "I have answered",
                                "Cancel request"
                              ],
                              "ApprovalCreationInput/title": "@{concat('More info needed - ', coalesce(body('Get_Parent_Ticket')?['Title'], outputs('Get_RITM_Fresh')?['body/RitmNumber'], 'your request'))}",
                              "ApprovalCreationInput/assignedTo": "@{coalesce(body('Get_Parent_Ticket')?['Caller/Email'], body('Get_Parent_Ticket')?['Caller/EMail'], last(split(coalesce(outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], '|'), '|')), 'itsm-admin@contoso.com')}",
                              "ApprovalCreationInput/details": "@{concat('To process your request ', outputs('Get_RITM_Fresh')?['body/RitmNumber'], ' we need a bit more information.', decodeUriComponent('%0A%0A'), coalesce(outputs('Compose_Intent_Shim')?['moreInfoNeeded'], 'a little more detail'), decodeUriComponent('%0A%0A'), 'Type your answers in the comments box below, then choose I have answered. If you no longer need this, choose Cancel request.')}",
                              "ApprovalCreationInput/itemLink": "@{concat('https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(outputs('Get_RITM_Fresh')?['body/ID']))}",
                              "ApprovalCreationInput/itemLinkDescription": "Open your request item",
                              "ApprovalCreationInput/enableNotifications": true,
                              "ApprovalCreationInput/enableReassignment": false
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                              "connectionName": "shared_approvals",
                              "operationId": "CreateAnApproval"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Wait_Clarify_Reply": {
                          "runAfter": {
                            "Create_Clarify_Approval": [
                              "Succeeded"
                            ]
                          },
                          "type": "OpenApiConnectionWebhook",
                          "inputs": {
                            "parameters": {
                              "approvalName": "@body('Create_Clarify_Approval')?['name']"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                              "connectionName": "shared_approvals",
                              "operationId": "WaitForAnApproval"
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "If_Clarify_Cancelled": {
                          "actions": {
                            "Patch_RITM_Cancelled": {
                              "runAfter": {},
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                  "connectionName": "shared_sharepointonline",
                                  "operationId": "PatchItem"
                                },
                                "parameters": {
                                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                  "table": "Request Items",
                                  "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                                  "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                                  "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                                  "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                                  "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                                  "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                                  "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                                  "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                                  "item/RitmState/Value": "Closed Incomplete",
                                  "item/CloseCode/Value": "Cancelled",
                                  "item/CloseNotes": "@{coalesce(body('Wait_Clarify_Reply')?['responses']?[0]?['comments'], 'Requester cancelled the request at clarification.')}",
                                  "item/ClosedDate": "@utcNow()",
                                  "item/WorkNotes": "Requester cancelled at clarification."
                                },
                                "authentication": "@parameters('$authentication')"
                              }
                            }
                          },
                          "runAfter": {
                            "Wait_Clarify_Reply": [
                              "Succeeded"
                            ]
                          },
                          "else": {
                            "actions": {
                              "Patch_RITM_Resume": {
                                "runAfter": {},
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                    "connectionName": "shared_sharepointonline",
                                    "operationId": "PatchItem"
                                  },
                                  "parameters": {
                                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                    "table": "Request Items",
                                    "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                                    "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                                    "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                                    "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                                    "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                                    "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                                    "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                                    "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                                    "item/RitmState/Value": "Pending Validation",
                                    "item/Variables": "@{concat(coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], ''), decodeUriComponent('%0A%0A'), 'Requester clarification: ', coalesce(body('Wait_Clarify_Reply')?['responses']?[0]?['comments'], ''))}",
                                    "item/WorkNotes": "@{concat('Requester answered the clarification; re-validating. Reply: ', coalesce(body('Wait_Clarify_Reply')?['responses']?[0]?['comments'], ''))}"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                }
                              },
                              "Call_ReValidate": {
                                "runAfter": {
                                  "Patch_RITM_Resume": [
                                    "Succeeded"
                                  ]
                                },
                                "type": "Http",
                                "inputs": {
                                  "method": "POST",
                                  "uri": "https://00000000000000000000000000000000.b5.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/REDACTED_WORKFLOW_ID/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=REDACTED",
                                  "headers": {
                                    "Content-Type": "application/json"
                                  },
                                  "body": {
                                    "ritmId": "@outputs('Get_RITM_Fresh')?['body/ID']"
                                  }
                                }
                              }
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@body('Wait_Clarify_Reply')?['responses']?[0]?['approverResponse']",
                                  "Cancel request"
                                ]
                              }
                            ]
                          },
                          "type": "If"
                        }
                      },
                      "runAfter": {
                        "Compose_Hold_Variables": [
                          "Succeeded"
                        ]
                      },
                      "else": {
                        "actions": {
                          "Patch_RITM_Handoff": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PatchItem"
                              },
                              "parameters": {
                                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                "table": "Request Items",
                                "id": "@outputs('Get_RITM_Fresh')?['body/ID']",
                                "item/Title": "@outputs('Get_RITM_Fresh')?['body/Title']",
                                "item/RitmNumber": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                                "item/ParentTicket/Id": "@outputs('Get_RITM_Fresh')?['body/ParentTicket/Id']",
                                "item/CatalogItem/Id": "@outputs('Get_RITM_Fresh')?['body/CatalogItem/Id']",
                                "item/RequestedFor/Claims": "@outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims']",
                                "item/RitmState/Value": "On Hold",
                                "item/Variables": "@string(outputs('Compose_Hold_Variables'))",
                                "item/OpenedDate": "@outputs('Get_RITM_Fresh')?['body/OpenedDate']",
                                "item/ConfidentialityLevel/Value": "@outputs('Get_RITM_Fresh')?['body/ConfidentialityLevel/Value']",
                                "item/WorkNotes": "@{concat('Could not auto-fulfill (out of catalog / no automated action / manual item); assigned to the IT service desk for manual fulfillment. Details: ', string(outputs('Compose_Hold_Variables')))}",
                                "item/AssignmentGroup/Claims": "c:0o.c|federateddirectoryclaimprovider|82ad6f09-59fe-42f6-b2c1-470a6bf4625f"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Create_CatalogDemand": {
                            "runAfter": {
                              "Patch_RITM_Handoff": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PostItem"
                              },
                              "parameters": {
                                "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                                "table": "Catalog Demand",
                                "item/Title": "@{concat(outputs('Get_RITM_Fresh')?['body/RitmNumber'], ' - ', coalesce(body('Parse_AI_Intent')?['resourceName'], body('Get_Catalog_Item')?['ItemName'], 'non-catalog request'))}",
                                "item/RequestedItem": "@coalesce(body('Get_Catalog_Item')?['ItemName'], outputs('Get_RITM_Fresh')?['body/Title'], '')",
                                "item/ResourceName": "@coalesce(body('Parse_AI_Intent')?['resourceName'], '')",
                                "item/JobTypeGuess": "@coalesce(body('Parse_AI_Intent')?['jobType'], '')",
                                "item/Requester": "@last(split(coalesce(outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], ''), '|'))",
                                "item/RitmRef": "@outputs('Get_RITM_Fresh')?['body/RitmNumber']",
                                "item/DemandStatus/Value": "New",
                                "item/DemandNotes": "@coalesce(body('Parse_AI_Intent')?['summary'], outputs('Compose_Intent_Shim')?['moreInfoNeeded'], '')"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          },
                          "Notify_Requester_Received": {
                            "runAfter": {
                              "Create_CatalogDemand": [
                                "Succeeded"
                              ]
                            },
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                                "connectionName": "shared_teams",
                                "operationId": "PostMessageToConversation"
                              },
                              "parameters": {
                                "poster": "Flow bot",
                                "location": "Chat with Flow bot",
                                "body/recipient": "@{coalesce(body('Get_Parent_Ticket')?['Caller/Email'], body('Get_Parent_Ticket')?['Caller/EMail'], last(split(coalesce(outputs('Get_RITM_Fresh')?['body/RequestedFor/Claims'], ''), '|')), 'itsm-admin@contoso.com')}",
                                "body/messageBody": "@{concat('<h2>Request received - IT is reviewing</h2><p>Your request <b>', outputs('Get_RITM_Fresh')?['body/RitmNumber'], '</b> (item ID ', string(outputs('Get_RITM_Fresh')?['body/ID']), ') could not be completed automatically and has been assigned to the IT service desk for review.</p><p><b>Operation:</b> ', coalesce(body('Parse_AI_Intent')?['jobType'], 'n/a'), ' &middot; <b>Target:</b> ', coalesce(body('Parse_AI_Intent')?['targetUserUpn'], '(none)'), ' &middot; <b>Resource:</b> ', coalesce(body('Parse_AI_Intent')?['resourceName'], '(none)'), '</p><p>', coalesce(body('Parse_AI_Intent')?['summary'], ''), '</p><p>If you can add detail (for example the exact product or group name), reply and it will speed things up.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(outputs('Get_RITM_Fresh')?['body/ID']), '\">Open request item</a></p>')}"
                              },
                              "authentication": "@parameters('$authentication')"
                            }
                          }
                        }
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@toLower(coalesce(outputs('Compose_Intent_Shim')?['outcome'], ''))",
                              "stop_and_ask"
                            ]
                          }
                        ]
                      },
                      "type": "If"
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@and(not(equals(toLower(coalesce(body('Parse_AI_Intent')?['confidence'], 'low')), 'low')), equals(length(coalesce(body('Parse_AI_Intent')?['missing'], json('[]'))), 0), or(not(equals(toLower(coalesce(body('Parse_AI_Intent')?['resourceType'], '')), 'group')), not(empty(coalesce(outputs('Compose_Intent_Shim')?['agentGroupId'], '')))))",
                        true
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@startsWith(trim(coalesce(outputs('Get_RITM_Fresh')?['body/Variables'], '')), '{')",
                  true
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {
        "Get_RITM_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_RITM_Fresh')?['body/RitmState/Value']",
              "Pending Validation"
            ]
          }
        ]
      },
      "type": "If"
    }
  },
  "outputs": {},
  "description": "3.2 RITM-Validation. stop_and_ask now sends the requester an interactive clarification Approval (questions in the card, answer in the comments box; 'I have answered' / 'Cancel request'); on answer the reply is appended to the RITM and 3.2 re-validates (self-invoke); on cancel the RITM is closed. Replaces the prior one-way notify. Structured/handoff paths unchanged."
}
