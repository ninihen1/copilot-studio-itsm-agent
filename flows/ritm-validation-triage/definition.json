{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_RITM_is_Created": {
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "evaluatedRecurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Request Items"
        },
        "authentication": "@parameters('$authentication')"
      },
      "conditions": [
        {
          "expression": "@equals(coalesce(triggerOutputs()?['body/RitmState/Value'], ''), 'Pending Validation')"
        }
      ]
    }
  },
  "actions": {
    "If_RITM_Pending_Validation": {
      "actions": {
        "Get_Parent_Ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tickets",
              "id": "@triggerOutputs()?['body/ParentTicket/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Catalog_Item": {
          "runAfter": {
            "Get_Parent_Ticket": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Service Catalog",
              "id": "@triggerOutputs()?['body/CatalogItem/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_Structured_Payload": {
          "actions": {
            "Parse_Structured_Payload": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@triggerOutputs()?['body/Variables']",
                "schema": {
                  "type": "object",
                  "properties": {
                    "skuPartNumber": {},
                    "skuId": {},
                    "action": {},
                    "requestedFor": {},
                    "justification": {},
                    "groupId": {},
                    "groupName": {}
                  }
                }
              }
            },
            "Compose_Structured_Validated": {
              "runAfter": {
                "Parse_Structured_Payload": [
                  "Succeeded"
                ]
              },
              "type": "Compose",
              "inputs": {
                "triageStatus": "Validated",
                "jobType": "@coalesce(body('Get_Catalog_Item')?['JobType'], '')",
                "action": "@coalesce(body('Parse_Structured_Payload')?['action'], 'assign')",
                "skuPartNumber": "@coalesce(body('Parse_Structured_Payload')?['skuPartNumber'], '')",
                "skuId": "@coalesce(body('Parse_Structured_Payload')?['skuId'], '')",
                "groupId": "@coalesce(body('Parse_Structured_Payload')?['groupId'], '')",
                "groupName": "@coalesce(body('Parse_Structured_Payload')?['groupName'], '')",
                "requestedFor": "@coalesce(body('Parse_Structured_Payload')?['requestedFor'], triggerOutputs()?['body/RequestedFor/Claims'], '')",
                "justification": "@coalesce(body('Parse_Structured_Payload')?['justification'], '')",
                "validatedAt": "@utcNow()",
                "validationSource": "Structured portal payload (no AI, no fuzzy match)"
              }
            },
            "Patch_RITM_Pending_Approval_Structured": {
              "runAfter": {
                "Compose_Structured_Validated": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Request Items",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/RitmNumber": "@triggerOutputs()?['body/RitmNumber']",
                  "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                  "item/CatalogItem/Id": "@triggerOutputs()?['body/CatalogItem/Id']",
                  "item/RequestedFor/Claims": "@triggerOutputs()?['body/RequestedFor/Claims']",
                  "item/RitmState/Value": "Pending Approval",
                  "item/Variables": "@string(outputs('Compose_Structured_Validated'))",
                  "item/OpenedDate": "@triggerOutputs()?['body/OpenedDate']",
                  "item/ConfidentialityLevel/Value": "@triggerOutputs()?['body/ConfidentialityLevel/Value']",
                  "item/WorkNotes": "@{concat('RITM validation passed via structured portal payload (JobType ', coalesce(body('Get_Catalog_Item')?['JobType'], 'n/a'), '). No AI extraction or fuzzy matching needed. Released to approval; approver reviews seats and cost.')}"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_Catalog_Item": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "AI_Builder_Create_Text_With_GPT": {
                "runAfter": {},
                "metadata": {
                  "flowSystemMetadata": {
                    "portalOperationId": "PredictV2",
                    "portalOperationGroup": "aibuilder",
                    "portalOperationApiDisplayNameOverride": "AI Builder",
                    "portalOperationIconOverride": "https://content.powerapps.com/resource/makerx/static/pauto/images/designeroperations/aibuilderIcon2026.8e878397.png",
                    "portalOperationBrandColorOverride": "#0A76C4",
                    "portalOperationApiTierOverride": "Standard"
                  },
                  "operationMetadataId": "ritm-validation-triage-ai-builder-gpt"
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "PredictV2"
                  },
                  "parameters": {
                    "recordId": "00000000-0000-0000-0000-000000000003",
                    "item/requestv2/RequestText": "@{concat('RITM: ', triggerOutputs()?['body/RitmNumber'], '. Catalog item: ', body('Get_Catalog_Item')?['ItemName'], '. Request text: ', coalesce(triggerOutputs()?['body/Variables'], body('Get_Parent_Ticket')?['Description'], body('Get_Parent_Ticket')?['ShortDescription'], ''))}"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Patch_RITM_AI_Down": {
                "runAfter": {
                  "AI_Builder_Create_Text_With_GPT": [
                    "Failed",
                    "TimedOut"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Request Items",
                    "id": "@triggerOutputs()?['body/ID']",
                    "item/Title": "@triggerOutputs()?['body/Title']",
                    "item/RitmNumber": "@triggerOutputs()?['body/RitmNumber']",
                    "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                    "item/CatalogItem/Id": "@triggerOutputs()?['body/CatalogItem/Id']",
                    "item/RequestedFor/Claims": "@triggerOutputs()?['body/RequestedFor/Claims']",
                    "item/RitmState/Value": "On Hold",
                    "item/Variables": "@coalesce(triggerOutputs()?['body/Variables'], '')",
                    "item/OpenedDate": "@triggerOutputs()?['body/OpenedDate']",
                    "item/ConfidentialityLevel/Value": "@triggerOutputs()?['body/ConfidentialityLevel/Value']",
                    "item/WorkNotes": "@{concat('Validation triage could not run: AI Builder text extraction failed (model unavailable). Auto-placed On Hold for manual validation. RITM ', triggerOutputs()?['body/RitmNumber'], ' at ', utcNow(), '.')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Notify_Catherine_AI_Down": {
                "runAfter": {
                  "Patch_RITM_AI_Down": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "connectionName": "shared_teams",
                    "operationId": "PostMessageToConversation"
                  },
                  "parameters": {
                    "poster": "Flow bot",
                    "location": "Chat with Flow bot",
                    "body/recipient": "catherine.han@flowstudio.app",
                    "body/messageBody": "@{concat('<h2>RITM validation could not run</h2><p>The AI extraction step failed (model unavailable), so <b>', triggerOutputs()?['body/RitmNumber'], '</b> (item ID ', string(triggerOutputs()?['body/ID']), ') was placed <b>On Hold</b> for manual validation.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(triggerOutputs()?['body/ID']), '\">Open request item</a></p>')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              },
              "Parse_AI_Intent": {
                "runAfter": {
                  "AI_Builder_Create_Text_With_GPT": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@coalesce(outputs('AI_Builder_Create_Text_With_GPT')?['body/responsev2/predictionOutput/text'], outputs('AI_Builder_Create_Text_With_GPT')?['body/responsev2/predictionOutput/Text'])",
                  "schema": {
                    "type": "object",
                    "required": [
                      "action",
                      "user",
                      "resource",
                      "confidence"
                    ],
                    "properties": {
                      "action": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      },
                      "resource": {
                        "type": "string"
                      },
                      "justification": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "high",
                          "medium",
                          "low"
                        ]
                      }
                    }
                  }
                }
              },
              "Compose_Lookup_Keys": {
                "runAfter": {
                  "Parse_AI_Intent": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": {
                  "userEmail": "@if(contains(coalesce(body('Parse_AI_Intent')?['user'], ''), '@'), trim(last(split(first(split(body('Parse_AI_Intent')?['user'], ')')), '('))), trim(coalesce(body('Parse_AI_Intent')?['user'], '')))",
                  "groupName": "@if(endswith(toLower(trim(coalesce(body('Parse_AI_Intent')?['resource'], ''))), ' group'), trim(substring(trim(body('Parse_AI_Intent')?['resource']), 0, sub(length(trim(body('Parse_AI_Intent')?['resource'])), 6))), if(endswith(toLower(trim(coalesce(body('Parse_AI_Intent')?['resource'], ''))), ' team'), trim(substring(trim(body('Parse_AI_Intent')?['resource']), 0, sub(length(trim(body('Parse_AI_Intent')?['resource'])), 5))), trim(coalesce(body('Parse_AI_Intent')?['resource'], ''))))"
                }
              },
              "Get_KV_Secret": {
                "runAfter": {
                  "Parse_AI_Intent": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                    "connectionName": "shared_keyvault",
                    "operationId": "GetSecret"
                  },
                  "parameters": {
                    "secretName": "SP-IT-Groups-ClientSecret"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Get_Graph_Token": {
                "runAfter": {
                  "Get_KV_Secret": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000001/oauth2/v2.0/token",
                  "headers": {
                    "Content-Type": "application/x-www-form-urlencoded"
                  },
                  "body": "@{concat('grant_type=client_credentials&client_id=00000000-0000-0000-0000-000000000002&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&client_secret=', encodeUriComponent(body('Get_KV_Secret')?['value']))}"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Parse_Graph_Token": {
                "runAfter": {
                  "Get_Graph_Token": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@body('Get_Graph_Token')",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "access_token": {
                        "type": "string"
                      },
                      "token_type": {
                        "type": "string"
                      },
                      "expires_in": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs"
                    ]
                  }
                }
              },
              "Graph_Find_Users": {
                "runAfter": {
                  "Parse_Graph_Token": [
                    "Succeeded"
                  ],
                  "Compose_Lookup_Keys": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{if(contains(outputs('Compose_Lookup_Keys')?['userEmail'], '@'), concat('https://graph.microsoft.com/v1.0/users?$filter=', encodeUriComponent(concat('userPrincipalName eq ''', outputs('Compose_Lookup_Keys')?['userEmail'], ''' or mail eq ''', outputs('Compose_Lookup_Keys')?['userEmail'], '''')), '&$select=id,displayName,userPrincipalName,mail&$top=2'), concat('https://graph.microsoft.com/v1.0/users?$search=\"displayName:', encodeUriComponent(outputs('Compose_Lookup_Keys')?['userEmail']), '\"&$select=id,displayName,userPrincipalName,mail&$top=2'))}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', body('Parse_Graph_Token')?['access_token'])}",
                    "ConsistencyLevel": "eventual"
                  }
                }
              },
              "Graph_Find_Groups": {
                "runAfter": {
                  "Graph_Find_Users": [
                    "Succeeded"
                  ]
                },
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "@{concat('https://graph.microsoft.com/v1.0/groups?$search=\"displayName:', encodeUriComponent(outputs('Compose_Lookup_Keys')?['groupName']), '\"&$select=id,displayName,mail&$top=2')}",
                  "headers": {
                    "Authorization": "@{concat('Bearer ', body('Parse_Graph_Token')?['access_token'])}",
                    "ConsistencyLevel": "eventual"
                  }
                }
              },
              "If_Exact_Validated_Match": {
                "actions": {
                  "Compose_Validated_Variables": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": {
                      "triageStatus": "Validated",
                      "action": "@toLower(body('Parse_AI_Intent')?['action'])",
                      "groupId": "@first(body('Graph_Find_Groups')?['value'])?['id']",
                      "groupName": "@first(body('Graph_Find_Groups')?['value'])?['displayName']",
                      "userId": "@first(body('Graph_Find_Users')?['value'])?['id']",
                      "userPrincipalName": "@first(body('Graph_Find_Users')?['value'])?['userPrincipalName']",
                      "userDisplayName": "@first(body('Graph_Find_Users')?['value'])?['displayName']",
                      "justification": "@coalesce(body('Parse_AI_Intent')?['justification'], '')",
                      "validationConfidence": "@body('Parse_AI_Intent')?['confidence']",
                      "validatedAt": "@utcNow()",
                      "validationSource": "AI extraction plus Microsoft Graph exact match",
                      "originalText": "@coalesce(triggerOutputs()?['body/Variables'], '')"
                    }
                  },
                  "Patch_RITM_Pending_Approval": {
                    "runAfter": {
                      "Compose_Validated_Variables": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                        "table": "Request Items",
                        "id": "@triggerOutputs()?['body/ID']",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/RitmNumber": "@triggerOutputs()?['body/RitmNumber']",
                        "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                        "item/CatalogItem/Id": "@triggerOutputs()?['body/CatalogItem/Id']",
                        "item/RequestedFor/Claims": "@triggerOutputs()?['body/RequestedFor/Claims']",
                        "item/RitmState/Value": "Pending Approval",
                        "item/Variables": "@string(outputs('Compose_Validated_Variables'))",
                        "item/OpenedDate": "@triggerOutputs()?['body/OpenedDate']",
                        "item/ConfidentialityLevel/Value": "@triggerOutputs()?['body/ConfidentialityLevel/Value']",
                        "item/WorkNotes": "@{concat('RITM validation triage passed. User ', first(body('Graph_Find_Users')?['value'])?['userPrincipalName'], ' and group ', first(body('Graph_Find_Groups')?['value'])?['displayName'], ' resolved exactly. Released to approval.')}"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                },
                "runAfter": {
                  "Graph_Find_Groups": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Compose_Hold_Variables": {
                      "runAfter": {},
                      "type": "Compose",
                      "inputs": {
                        "triageStatus": "NeedsClarification",
                        "reason": "AI confidence, action, user resolution, or group resolution did not meet exact-match requirements.",
                        "extractedAction": "@body('Parse_AI_Intent')?['action']",
                        "extractedUser": "@body('Parse_AI_Intent')?['user']",
                        "extractedResource": "@body('Parse_AI_Intent')?['resource']",
                        "lookupUserEmail": "@outputs('Compose_Lookup_Keys')?['userEmail']",
                        "lookupGroupName": "@outputs('Compose_Lookup_Keys')?['groupName']",
                        "validationConfidence": "@body('Parse_AI_Intent')?['confidence']",
                        "userMatchCount": "@length(coalesce(body('Graph_Find_Users')?['value'], createArray()))",
                        "groupMatchCount": "@length(coalesce(body('Graph_Find_Groups')?['value'], createArray()))",
                        "originalText": "@coalesce(triggerOutputs()?['body/Variables'], '')"
                      }
                    },
                    "Patch_RITM_On_Hold": {
                      "runAfter": {
                        "Compose_Hold_Variables": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                          "table": "Request Items",
                          "id": "@triggerOutputs()?['body/ID']",
                          "item/Title": "@triggerOutputs()?['body/Title']",
                          "item/RitmNumber": "@triggerOutputs()?['body/RitmNumber']",
                          "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                          "item/CatalogItem/Id": "@triggerOutputs()?['body/CatalogItem/Id']",
                          "item/RequestedFor/Claims": "@triggerOutputs()?['body/RequestedFor/Claims']",
                          "item/RitmState/Value": "On Hold",
                          "item/Variables": "@string(outputs('Compose_Hold_Variables'))",
                          "item/OpenedDate": "@triggerOutputs()?['body/OpenedDate']",
                          "item/ConfidentialityLevel/Value": "@triggerOutputs()?['body/ConfidentialityLevel/Value']",
                          "item/WorkNotes": "@{concat('RITM validation triage put this request on hold. Catherine must clarify the user/group before approval or SCTASK generation. Details: ', string(outputs('Compose_Hold_Variables')))}"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Notify_Catherine_Clarification": {
                      "runAfter": {
                        "Patch_RITM_On_Hold": [
                          "Succeeded"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                          "connectionName": "shared_teams",
                          "operationId": "PostMessageToConversation"
                        },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Chat with Flow bot",
                          "body/recipient": "catherine.han@flowstudio.app",
                          "body/messageBody": "@{concat('<h2>RITM needs clarification</h2><p><b>RITM:</b> ', triggerOutputs()?['body/RitmNumber'], ' (item ID ', string(triggerOutputs()?['body/ID']), ')</p><p><b>Extracted user:</b> ', string(body('Parse_AI_Intent')?['user']), '</p><p><b>Extracted group:</b> ', string(body('Parse_AI_Intent')?['resource']), '</p><p><b>Reason:</b> exact Graph validation failed or confidence was too low.</p><p><a href=\"https://contoso.sharepoint.com/sites/ITSM/Lists/Request%20Items/DispForm.aspx?ID=', string(triggerOutputs()?['body/ID']), '\">Open request item</a></p>')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                },
                "expression": {
                  "and": [
                    {
                      "equals": [
                        "@toLower(body('Parse_AI_Intent')?['confidence'])",
                        "high"
                      ]
                    },
                    {
                      "equals": [
                        "@toLower(body('Parse_AI_Intent')?['action'])",
                        "add"
                      ]
                    },
                    {
                      "equals": [
                        "@length(coalesce(body('Graph_Find_Users')?['value'], createArray()))",
                        1
                      ]
                    },
                    {
                      "equals": [
                        "@length(coalesce(body('Graph_Find_Groups')?['value'], createArray()))",
                        1
                      ]
                    },
                    {
                      "equals": [
                        "@toLower(first(body('Graph_Find_Groups')?['value'])?['displayName'])",
                        "@toLower(outputs('Compose_Lookup_Keys')?['groupName'])"
                      ]
                    }
                  ]
                },
                "type": "If"
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@startsWith(trim(coalesce(triggerOutputs()?['body/Variables'], '')), '{')",
                  true
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {},
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@triggerOutputs()?['body/RitmState/Value']",
              "Pending Validation"
            ]
          }
        ]
      },
      "type": "If"
    }
  },
