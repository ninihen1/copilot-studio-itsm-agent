{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_PJ_is_Modified": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Provisioning Jobs"
        },
        "authentication": "@parameters('$authentication')"
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 3
      },
      "splitOn": "@triggerOutputs()?['body/value']"
    }
  },
  "actions": {
    "If_Sharepoint_Dispatched": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "and": [
          {
            "equals": [
              "@triggerOutputs()?['body/JobStatus/Value']",
              "Dispatched"
            ]
          },
          {
            "startsWith": [
              "@coalesce(triggerOutputs()?['body/JobType'],'')",
              "sharepoint."
            ]
          }
        ]
      },
      "actions": {
        "Update_Status_InProgress": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "id": "@triggerOutputs()?['body/ID']",
              "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
              "item/JobType": "@triggerOutputs()?['body/JobType']",
              "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
              "item/JobStatus/Value": "InProgress",
              "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
              "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
              "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
              "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
              "item/ServicePrincipal": "SP-IT-SharePoint",
              "item/StartedAt": "@utcNow()"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_KV_Secret": {
          "runAfter": {
            "Update_Status_InProgress": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
              "connectionName": "shared_keyvault",
              "operationId": "GetSecret"
            },
            "parameters": {
              "secretName": "SP-IT-SharePoint-ClientSecret"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Get_Graph_Token": {
          "runAfter": {
            "Get_KV_Secret": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://login.microsoftonline.com/00000000-0000-4000-8000-000000000009/oauth2/v2.0/token",
            "headers": {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            "body": "@{concat('grant_type=client_credentials&client_id=00000000-0000-4000-8000-000000000046&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&client_secret=', encodeUriComponent(body('Get_KV_Secret')?['value']))}"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Parse_Token": {
          "runAfter": {
            "Get_Graph_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Graph_Token')",
            "schema": {
              "type": "object",
              "properties": {
                "token_type": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer"
                },
                "access_token": {
                  "type": "string"
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Parse_Target": {
          "runAfter": {
            "Parse_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@triggerOutputs()?['body/TargetJson']",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "upn": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Switch_JobType": {
          "runAfter": {
            "Parse_Target": [
              "Succeeded"
            ]
          },
          "type": "Switch",
          "expression": "@triggerOutputs()?['body/JobType']",
          "default": {
            "actions": {
              "Update_Failed_UnsupportedJobType": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Provisioning Jobs",
                    "id": "@triggerOutputs()?['body/ID']",
                    "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                    "item/JobType": "@triggerOutputs()?['body/JobType']",
                    "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                    "item/JobStatus/Value": "Failed",
                    "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                    "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                    "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                    "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                    "item/ServicePrincipal": "SP-IT-SharePoint",
                    "item/CompletedAt": "@utcNow()",
                    "item/ErrorJson": "@{concat('{\"reason\":\"unsupported_jobtype\",\"jobType\":\"', triggerOutputs()?['body/JobType'], '\",\"executor\":\"SP-IT-SharePoint\"}')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "cases": {
            "JobType_RestoreFile": {
              "case": "sharepoint.restoreFile",
              "actions": {
                "Http_Graph_RestoreFile": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "@coalesce(json(triggerOutputs()?['body/ArgsJson'])?['siteUrl'], 'https://contoso.sharepoint.com/sites/ITSM')",
                      "parameters/method": "POST",
                      "parameters/uri": "@{concat('_api/web/RecycleBin(guid''', coalesce(json(triggerOutputs()?['body/ArgsJson'])?['recycleBinItemId'], json(triggerOutputs()?['body/ArgsJson'])?['itemId']), ''')/restore()')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Succeeded_RestoreFile": {
                  "runAfter": {
                    "Http_Graph_RestoreFile": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-SharePoint",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RestoreFile')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RestoreFile')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"fileRestored\":true,\"siteUrl\":\"', coalesce(json(triggerOutputs()?['body/ArgsJson'])?['siteUrl'], 'https://contoso.sharepoint.com/sites/ITSM'), '\",\"recycleBinItemId\":\"', coalesce(json(triggerOutputs()?['body/ArgsJson'])?['recycleBinItemId'], json(triggerOutputs()?['body/ArgsJson'])?['itemId']), '\"}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_RestoreFile": {
                  "runAfter": {
                    "Http_Graph_RestoreFile": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-SharePoint",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RestoreFile')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RestoreFile')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_RestoreFile'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}
