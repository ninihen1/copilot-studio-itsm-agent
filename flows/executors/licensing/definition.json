{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "required": [
            "pjId"
          ],
          "properties": {
            "pjId": {
              "type": "integer"
            },
            "jobId": {
              "type": "string"
            },
            "jobType": {
              "type": "string"
            },
            "ticketId": {
              "type": "integer"
            },
            "callerUpn": {
              "type": "string"
            },
            "idempotencyKey": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            }
          }
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "If_Licensing_Dispatched": {
      "actions": {
        "Update_Status_InProgress": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
              "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
              "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
              "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
              "item/JobStatus/Value": "InProgress",
              "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
              "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
              "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
              "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
              "item/ServicePrincipal": "SP-IT-Licensing",
              "item/StartedAt": "@utcNow()"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_KV_Secret": {
          "runAfter": {
            "Update_Status_InProgress": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
              "connectionName": "shared_keyvault",
              "operationId": "GetSecret"
            },
            "parameters": {
              "secretName": "SP-IT-Licensing-ClientSecret"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Get_Graph_Token": {
          "runAfter": {
            "Get_KV_Secret": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000001/oauth2/v2.0/token",
            "headers": {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            "body": "@{concat('grant_type=client_credentials&client_id=00000000-0000-0000-0000-000000000007&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&client_secret=', encodeUriComponent(body('Get_KV_Secret')?['value']))}"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Parse_Token": {
          "runAfter": {
            "Get_Graph_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Graph_Token')",
            "schema": {
              "type": "object",
              "properties": {
                "token_type": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer"
                },
                "access_token": {
                  "type": "string"
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Parse_Target": {
          "runAfter": {
            "Parse_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "upn": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Switch_JobType": {
          "runAfter": {
            "Parse_Target": [
              "Succeeded"
            ]
          },
          "cases": {
            "JobType_AssignLicense": {
              "case": "licensing.assign",
              "actions": {
                "Compose_Body_AssignLicense": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": {
                    "addLicenses": [
                      {
                        "skuId": "@{coalesce(if(empty(coalesce(outputs('Get_PJ_Fresh')?['body/ArgsJson'],'')), null, json(outputs('Get_PJ_Fresh')?['body/ArgsJson'])?['skuId']), '00000000-0000-0000-0000-000000000000')}",
                        "disabledPlans": []
                      }
                    ],
                    "removeLicenses": []
                  }
                },
                "Http_Graph_AssignLicense": {
                  "runAfter": {
                    "Compose_Body_AssignLicense": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Parse_Target')?['upn'], '/assignLicense')}",
                    "headers": {
                      "Authorization": "@{concat('Bearer ', body('Parse_Token')?['access_token'])}",
                      "Content-Type": "application/json"
                    },
                    "body": "@outputs('Compose_Body_AssignLicense')"
                  }
                },
                "Update_Succeeded_AssignLicense": {
                  "runAfter": {
                    "Http_Graph_AssignLicense": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_AssignLicense')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_AssignLicense')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"licenseAssigned\":true,\"targetUpn\":\"', body('Parse_Target')?['upn'], '\"}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_AssignLicense": {
                  "runAfter": {
                    "Http_Graph_AssignLicense": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_AssignLicense')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_AssignLicense')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_AssignLicense'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "JobType_RevokeLicense": {
              "case": "licensing.revoke",
              "actions": {
                "Compose_Body_RevokeLicense": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": {
                    "addLicenses": [],
                    "removeLicenses": [
                      "@{coalesce(if(empty(coalesce(outputs('Get_PJ_Fresh')?['body/ArgsJson'],'')), null, json(outputs('Get_PJ_Fresh')?['body/ArgsJson'])?['skuId']), '00000000-0000-0000-0000-000000000000')}"
                    ]
                  }
                },
                "Http_Graph_RevokeLicense": {
                  "runAfter": {
                    "Compose_Body_RevokeLicense": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Parse_Target')?['upn'], '/assignLicense')}",
                    "headers": {
                      "Authorization": "@{concat('Bearer ', body('Parse_Token')?['access_token'])}",
                      "Content-Type": "application/json"
                    },
                    "body": "@outputs('Compose_Body_RevokeLicense')"
                  }
                },
                "Update_Succeeded_RevokeLicense": {
                  "runAfter": {
                    "Http_Graph_RevokeLicense": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RevokeLicense')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RevokeLicense')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"licenseRevoked\":true,\"targetUpn\":\"', body('Parse_Target')?['upn'], '\"}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_RevokeLicense": {
                  "runAfter": {
                    "Http_Graph_RevokeLicense": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RevokeLicense')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RevokeLicense')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_RevokeLicense'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "JobType_ChangeSku": {
              "case": "licensing.changeSku",
              "actions": {
                "Compose_Body_ChangeSku": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": {
                    "addLicenses": [
                      {
                        "skuId": "@{coalesce(if(empty(coalesce(outputs('Get_PJ_Fresh')?['body/ArgsJson'],'')), null, json(outputs('Get_PJ_Fresh')?['body/ArgsJson'])?['newSkuId']), '00000000-0000-0000-0000-000000000000')}",
                        "disabledPlans": []
                      }
                    ],
                    "removeLicenses": [
                      "@{coalesce(if(empty(coalesce(outputs('Get_PJ_Fresh')?['body/ArgsJson'],'')), null, json(outputs('Get_PJ_Fresh')?['body/ArgsJson'])?['oldSkuId']), '00000000-0000-0000-0000-000000000000')}"
                    ]
                  }
                },
                "Http_Graph_ChangeSku": {
                  "runAfter": {
                    "Compose_Body_ChangeSku": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat('https://graph.microsoft.com/v1.0/users/', body('Parse_Target')?['upn'], '/assignLicense')}",
                    "headers": {
                      "Authorization": "@{concat('Bearer ', body('Parse_Token')?['access_token'])}",
                      "Content-Type": "application/json"
                    },
                    "body": "@outputs('Compose_Body_ChangeSku')"
                  }
                },
                "Update_Succeeded_ChangeSku": {
                  "runAfter": {
                    "Http_Graph_ChangeSku": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_ChangeSku')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_ChangeSku')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"skuChanged\":true,\"targetUpn\":\"', body('Parse_Target')?['upn'], '\"}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_ChangeSku": {
                  "runAfter": {
                    "Http_Graph_ChangeSku": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                      "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                      "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                      "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                      "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                      "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Licensing",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_ChangeSku')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_ChangeSku')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_ChangeSku'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Update_Failed_UnsupportedJobType": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Provisioning Jobs",
                    "id": "@outputs('Get_PJ_Fresh')?['body/ID']",
                    "item/Title": "@coalesce(outputs('Get_PJ_Fresh')?['body/Title'], 'PJ-fallback')",
                    "item/JobType": "@outputs('Get_PJ_Fresh')?['body/JobType']",
                    "item/ParentTicket/Id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                    "item/JobStatus/Value": "Failed",
                    "item/CallerUpn": "@outputs('Get_PJ_Fresh')?['body/CallerUpn']",
                    "item/TargetJson": "@outputs('Get_PJ_Fresh')?['body/TargetJson']",
                    "item/IdempotencyKey": "@outputs('Get_PJ_Fresh')?['body/IdempotencyKey']",
                    "item/CorrelationId": "@outputs('Get_PJ_Fresh')?['body/CorrelationId']",
                    "item/ServicePrincipal": "SP-IT-Licensing",
                    "item/CompletedAt": "@utcNow()",
                    "item/ErrorJson": "@{concat('{\"reason\":\"unsupported_jobtype\",\"jobType\":\"', outputs('Get_PJ_Fresh')?['body/JobType'], '\",\"executor\":\"SP-IT-Licensing\"}')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "expression": "@outputs('Get_PJ_Fresh')?['body/JobType']",
          "type": "Switch"
        },
        "Call_Resolver_On_Done": {
          "runAfter": {
            "Switch_JobType": [
              "Succeeded",
              "Failed",
              "Skipped"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://REDACTED-FLOW-TRIGGER-URL",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "pjId": "@outputs('Get_PJ_Fresh')?['body/ID']"
            }
          }
        }
      },
      "runAfter": {
        "Get_PJ_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_PJ_Fresh')?['body/JobStatus/Value']",
              "Dispatched"
            ]
          },
          {
            "startsWith": [
              "@coalesce(outputs('Get_PJ_Fresh')?['body/JobType'],'')",
              "licensing."
            ]
          }
        ]
      },
      "type": "If"
    },
    "Get_PJ_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Provisioning Jobs",
          "id": "@triggerBody()?['pjId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "description": "5.3-licensing executor. 2026-06-02 poll->push: HTTP Request {pjId}, fields via Get_PJ_Fresh(live), calls resolver on done. #flowstudio-mcp"
}
