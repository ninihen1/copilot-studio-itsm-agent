{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_PJ_is_Modified": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Provisioning Jobs"
        },
        "authentication": "@parameters('$authentication')"
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 3
      },
      "splitOn": "@triggerOutputs()?['body/value']"
    }
  },
  "actions": {
    "If_Exchange_Dispatched": {
      "runAfter": {},
      "type": "If",
      "expression": {
        "and": [
          {
            "equals": [
              "@triggerOutputs()?['body/JobStatus/Value']",
              "Dispatched"
            ]
          },
          {
            "startsWith": [
              "@coalesce(triggerOutputs()?['body/JobType'],'')",
              "exchange."
            ]
          }
        ]
      },
      "actions": {
        "Update_Status_InProgress": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "id": "@triggerOutputs()?['body/ID']",
              "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
              "item/JobType": "@triggerOutputs()?['body/JobType']",
              "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
              "item/JobStatus/Value": "InProgress",
              "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
              "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
              "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
              "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
              "item/ServicePrincipal": "SP-IT-Exchange",
              "item/StartedAt": "@utcNow()"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_KV_Secret": {
          "runAfter": {
            "Update_Status_InProgress": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
              "connectionName": "shared_keyvault",
              "operationId": "GetSecret"
            },
            "parameters": {
              "secretName": "SP-IT-Exchange-ClientSecret"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Get_Graph_Token": {
          "runAfter": {
            "Get_KV_Secret": [
              "Succeeded"
            ]
          },
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://login.microsoftonline.com/00000000-0000-4000-8000-000000000009/oauth2/v2.0/token",
            "headers": {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            "body": "@{concat('grant_type=client_credentials&client_id=00000000-0000-4000-8000-000000000058&scope=https%3A%2F%2Fgraph.microsoft.com%2F.default&client_secret=', encodeUriComponent(body('Get_KV_Secret')?['value']))}"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Parse_Token": {
          "runAfter": {
            "Get_Graph_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@body('Get_Graph_Token')",
            "schema": {
              "type": "object",
              "properties": {
                "token_type": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer"
                },
                "access_token": {
                  "type": "string"
                }
              }
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Parse_Target": {
          "runAfter": {
            "Parse_Token": [
              "Succeeded"
            ]
          },
          "type": "ParseJson",
          "inputs": {
            "content": "@triggerOutputs()?['body/TargetJson']",
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "upn": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Get_KV_Secret_FunctionKey": {
          "runAfter": {
            "Parse_Target": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
              "connectionName": "shared_keyvault",
              "operationId": "GetSecret"
            },
            "parameters": {
              "secretName": "ExoMailboxPermission-FunctionKey"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "secureData": { "properties": ["inputs", "outputs"] }
          },
          "description": "Phase 3.1 — fetches the Function key for exo-mailbox-permission. Stored in KV as 'ExoMailboxPermission-FunctionKey'."
        },
        "Switch_JobType": {
          "runAfter": {
            "Get_KV_Secret_FunctionKey": [
              "Succeeded"
            ]
          },
          "type": "Switch",
          "expression": "@triggerOutputs()?['body/JobType']",
          "default": {
            "actions": {
              "Update_Failed_UnsupportedJobType": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem"
                  },
                  "parameters": {
                    "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                    "table": "Provisioning Jobs",
                    "id": "@triggerOutputs()?['body/ID']",
                    "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                    "item/JobType": "@triggerOutputs()?['body/JobType']",
                    "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                    "item/JobStatus/Value": "Failed",
                    "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                    "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                    "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                    "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                    "item/ServicePrincipal": "SP-IT-Exchange",
                    "item/CompletedAt": "@utcNow()",
                    "item/ErrorJson": "@{concat('{\"reason\":\"unsupported_jobtype\",\"jobType\":\"', triggerOutputs()?['body/JobType'], '\",\"executor\":\"SP-IT-Exchange\"}')}"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          },
          "cases": {
            "JobType_GrantFullAccess": {
              "case": "exchange.grantFullAccess",
              "actions": {
                "Compose_Body_GrantFullAccess": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": {
                    "action": "grant",
                    "mailboxUpn": "@{coalesce(if(empty(coalesce(triggerOutputs()?['body/ArgsJson'],'')), null, json(triggerOutputs()?['body/ArgsJson'])?['mailboxUpn']), '')}",
                    "delegateUpn": "@{body('Parse_Target')?['upn']}",
                    "accessRights": "FullAccess",
                    "autoMapping": true,
                    "correlationId": "@{triggerOutputs()?['body/CorrelationId']}"
                  }
                },
                "Http_Graph_GrantFullAccess": {
                  "runAfter": {
                    "Compose_Body_GrantFullAccess": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat('https://func-itsm-dev.azurewebsites.net/api/exo-mailbox-permission?code=', body('Get_KV_Secret_FunctionKey')?['value'])}",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": "@outputs('Compose_Body_GrantFullAccess')"
                  },
                  "runtimeConfiguration": {
                    "secureData": { "properties": ["inputs"] }
                  }
                },
                "Update_Succeeded_GrantFullAccess": {
                  "runAfter": {
                    "Http_Graph_GrantFullAccess": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Exchange",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_GrantFullAccess')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_GrantFullAccess')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"fullAccessGranted\":true,\"mailbox\":\"', coalesce(if(empty(coalesce(triggerOutputs()?['body/ArgsJson'],'')), null, json(triggerOutputs()?['body/ArgsJson'])?['mailboxUpn']), ''), '\",\"delegate\":\"', body('Parse_Target')?['upn'], '\",\"functionResponse\":', string(body('Http_Graph_GrantFullAccess')), '}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_GrantFullAccess": {
                  "runAfter": {
                    "Http_Graph_GrantFullAccess": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Exchange",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_GrantFullAccess')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_GrantFullAccess')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_GrantFullAccess'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            },
            "JobType_RevokeFullAccess": {
              "case": "exchange.revokeFullAccess",
              "actions": {
                "Compose_Body_RevokeFullAccess": {
                  "runAfter": {},
                  "type": "Compose",
                  "inputs": {
                    "action": "revoke",
                    "mailboxUpn": "@{coalesce(if(empty(coalesce(triggerOutputs()?['body/ArgsJson'],'')), null, json(triggerOutputs()?['body/ArgsJson'])?['mailboxUpn']), '')}",
                    "delegateUpn": "@{body('Parse_Target')?['upn']}",
                    "accessRights": "FullAccess",
                    "correlationId": "@{triggerOutputs()?['body/CorrelationId']}"
                  }
                },
                "Http_Graph_RevokeFullAccess": {
                  "runAfter": {
                    "Compose_Body_RevokeFullAccess": [
                      "Succeeded"
                    ]
                  },
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat('https://func-itsm-dev.azurewebsites.net/api/exo-mailbox-permission?code=', body('Get_KV_Secret_FunctionKey')?['value'])}",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": "@outputs('Compose_Body_RevokeFullAccess')"
                  },
                  "runtimeConfiguration": {
                    "secureData": { "properties": ["inputs"] }
                  }
                },
                "Update_Succeeded_RevokeFullAccess": {
                  "runAfter": {
                    "Http_Graph_RevokeFullAccess": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Succeeded",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Exchange",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RevokeFullAccess')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RevokeFullAccess')?['headers']?['request-id'])",
                      "item/ResultJson": "@{concat('{\"fullAccessRevoked\":true,\"mailbox\":\"', coalesce(if(empty(coalesce(triggerOutputs()?['body/ArgsJson'],'')), null, json(triggerOutputs()?['body/ArgsJson'])?['mailboxUpn']), ''), '\",\"delegate\":\"', body('Parse_Target')?['upn'], '\",\"functionResponse\":', string(body('Http_Graph_RevokeFullAccess')), '}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Update_Failed_RevokeFullAccess": {
                  "runAfter": {
                    "Http_Graph_RevokeFullAccess": [
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem"
                    },
                    "parameters": {
                      "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                      "table": "Provisioning Jobs",
                      "id": "@triggerOutputs()?['body/ID']",
                      "item/Title": "@coalesce(triggerOutputs()?['body/Title'], 'PJ-fallback')",
                      "item/JobType": "@triggerOutputs()?['body/JobType']",
                      "item/ParentTicket/Id": "@triggerOutputs()?['body/ParentTicket/Id']",
                      "item/JobStatus/Value": "Failed",
                      "item/CallerUpn": "@triggerOutputs()?['body/CallerUpn']",
                      "item/TargetJson": "@triggerOutputs()?['body/TargetJson']",
                      "item/IdempotencyKey": "@triggerOutputs()?['body/IdempotencyKey']",
                      "item/CorrelationId": "@triggerOutputs()?['body/CorrelationId']",
                      "item/ServicePrincipal": "SP-IT-Exchange",
                      "item/CompletedAt": "@utcNow()",
                      "item/DurationMs": "@div(sub(ticks(utcNow()), ticks(body('Update_Status_InProgress')?['StartedAt'])), 10000)",
                      "item/GraphRequestId": "@coalesce(outputs('Http_Graph_RevokeFullAccess')?['headers']?['x-ms-correlation-id'], outputs('Http_Graph_RevokeFullAccess')?['headers']?['request-id'])",
                      "item/ErrorJson": "@{string(body('Http_Graph_RevokeFullAccess'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    }
  }
}