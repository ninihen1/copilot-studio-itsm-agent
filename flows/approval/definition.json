{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_an_Approval_is_Modified": {
      "recurrence": {
        "frequency": "Minute",
        "interval": 3
      },
      "evaluatedRecurrence": {
        "frequency": "Minute",
        "interval": 3
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Approvals"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "If_Terminal_State": {
      "actions": {
        "Get_Linked_PJ": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Provisioning Jobs",
              "$filter": "@{concat('Title eq ''', triggerOutputs()?['body/LinkedJobId'], '''')}",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_PJ_Found": {
          "actions": {
            "Switch_On_State": {
              "runAfter": {},
              "cases": {
                "Case_Approved": {
                  "case": "Approved",
                  "actions": {
                    "Call_Dispatcher": {
                      "runAfter": {},
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://contoso-flow-trigger-url-REDACTED",
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "pjId": "@first(body('Get_Linked_PJ')?['value'])?['ID']",
                          "idempotencyKey": "@coalesce(triggerOutputs()?['body/Title'], guid())",
                          "callerUpn": "@first(body('Get_Linked_PJ')?['value'])?['CallerUpn']",
                          "approverUpn": "@coalesce(triggerOutputs()?['body/Editor/Email'], 'system')",
                          "approvalSessionId": "@triggerOutputs()?['body/Title']",
                          "jobType": "@first(body('Get_Linked_PJ')?['value'])?['JobType']",
                          "correlationId": "@coalesce(first(body('Get_Linked_PJ')?['value'])?['CorrelationId'], guid())"
                        }
                      }
                    },
                    "Mark_Approval_Completed_Approved": {
                      "runAfter": {
                        "Call_Dispatcher": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                          "table": "Approvals",
                          "id": "@triggerOutputs()?['body/ID']",
                          "item/Title": "@triggerOutputs()?['body/Title']",
                          "item/PolicyApplied/Id": "@triggerOutputs()?['body/PolicyApplied/Id']",
                          "item/PolicyVersionUsed": "@triggerOutputs()?['body/PolicyVersionUsed']",
                          "item/SessionState/Value": "Approved",
                          "item/CompletedAt": "@utcNow()",
                          "item/DurationMinutes": "@div(sub(ticks(utcNow()), ticks(triggerOutputs()?['body/Created'])), 600000000)"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                },
                "Case_Rejected": {
                  "case": "Rejected",
                  "actions": {
                    "Patch_PJ_To_Rejected": {
                      "runAfter": {},
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                          "table": "Provisioning Jobs",
                          "id": "@first(body('Get_Linked_PJ')?['value'])?['ID']",
                          "item/Title": "@first(body('Get_Linked_PJ')?['value'])?['Title']",
                          "item/JobType": "@first(body('Get_Linked_PJ')?['value'])?['JobType']",
                          "item/ParentTicket/Id": "@first(body('Get_Linked_PJ')?['value'])?['ParentTicket']?['Id']",
                          "item/JobStatus/Value": "Rejected",
                          "item/CallerUpn": "@first(body('Get_Linked_PJ')?['value'])?['CallerUpn']",
                          "item/TargetJson": "@first(body('Get_Linked_PJ')?['value'])?['TargetJson']",
                          "item/IdempotencyKey": "@first(body('Get_Linked_PJ')?['value'])?['IdempotencyKey']",
                          "item/CorrelationId": "@first(body('Get_Linked_PJ')?['value'])?['CorrelationId']",
                          "item/ApprovalSessionId": "@triggerOutputs()?['body/Title']",
                          "item/CompletedAt": "@utcNow()",
                          "item/ErrorJson": "@{concat('{\"reason\":\"approval_rejected\",\"approvalSessionId\":\"', triggerOutputs()?['body/Title'], '\",\"rejectionReason\":', if(equals(coalesce(triggerOutputs()?['body/RejectionReason'],''),''), 'null', concat('\"', triggerOutputs()?['body/RejectionReason'], '\"')), '}')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    },
                    "Mark_Approval_Completed_Rejected": {
                      "runAfter": {
                        "Patch_PJ_To_Rejected": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      },
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem"
                        },
                        "parameters": {
                          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                          "table": "Approvals",
                          "id": "@triggerOutputs()?['body/ID']",
                          "item/Title": "@triggerOutputs()?['body/Title']",
                          "item/PolicyApplied/Id": "@triggerOutputs()?['body/PolicyApplied/Id']",
                          "item/PolicyVersionUsed": "@triggerOutputs()?['body/PolicyVersionUsed']",
                          "item/SessionState/Value": "Rejected",
                          "item/CompletedAt": "@utcNow()",
                          "item/DurationMinutes": "@div(sub(ticks(utcNow()), ticks(triggerOutputs()?['body/Created'])), 600000000)"
                        },
                        "authentication": "@parameters('$authentication')"
                      }
                    }
                  }
                }
              },
              "default": {
                "actions": {}
              },
              "expression": "@triggerOutputs()?['body/SessionState/Value']",
              "type": "Switch"
            }
          },
          "runAfter": {
            "Get_Linked_PJ": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(coalesce(body('Get_Linked_PJ')?['value'], createArray()))",
                  0
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {},
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "or": [
              {
                "equals": [
                  "@triggerOutputs()?['body/SessionState/Value']",
                  "Approved"
                ]
              },
              {
                "equals": [
                  "@triggerOutputs()?['body/SessionState/Value']",
                  "Rejected"
                ]
              }
            ]
          },
          {
            "equals": [
              "@coalesce(triggerOutputs()?['body/CompletedAt'], '')",
              ""
            ]
          }
        ]
      },
      "type": "If"
    }
  }
}