{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "pjId": {
              "type": "integer"
            },
            "parentTicketId": {
              "type": "integer"
            },
            "jobType": {
              "type": "string"
            },
            "jobStatus": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            },
            "idempotencyKey": {
              "type": "string"
            }
          },
          "required": [
            "pjId"
          ]
        },
        "triggerAuthenticationType": "All"
      }
    }
  },
  "actions": {
    "Get_PJ_Fresh": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItem"
        },
        "parameters": {
          "dataset": "https://contoso.sharepoint.com/sites/ITSM",
          "table": "Provisioning Jobs",
          "id": "@triggerBody()?['pjId']"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "If_PJ_Succeeded_ProposePath": {
      "actions": {
        "Get_Parent_Ticket": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/ITSM",
              "table": "Tickets",
              "id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "If_Ticket_Open": {
          "actions": {
            "Resolve_Ticket": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Tickets",
                  "id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                  "item/Title": "@outputs('Get_Parent_Ticket')?['body/Title']",
                  "item/ShortDescription": "@outputs('Get_Parent_Ticket')?['body/ShortDescription']",
                  "item/TicketState/Value": "Resolved",
                  "item/CloseCode/Value": "Solved Permanently",
                  "item/ResolvedDate": "@utcNow()",
                  "item/CloseNotes": "@{concat('Auto-resolved by PJ-Ticket-Resolver: provisioning job ', coalesce(outputs('Get_PJ_Fresh')?['body/Title'], ''), ' (', coalesce(outputs('Get_PJ_Fresh')?['body/JobType'], ''), ') completed successfully.')}"
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 3,
                  "interval": "PT5S"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Delay_Before_Retry": {
              "runAfter": {
                "Resolve_Ticket": [
                  "Failed",
                  "TimedOut"
                ]
              },
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 8,
                  "unit": "Second"
                }
              }
            },
            "Resolve_Ticket_Retry": {
              "runAfter": {
                "Delay_Before_Retry": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/ITSM",
                  "table": "Tickets",
                  "id": "@outputs('Get_PJ_Fresh')?['body/ParentTicket/Id']",
                  "item/Title": "@outputs('Get_Parent_Ticket')?['body/Title']",
                  "item/ShortDescription": "@outputs('Get_Parent_Ticket')?['body/ShortDescription']",
                  "item/TicketState/Value": "Resolved",
                  "item/CloseCode/Value": "Solved Permanently",
                  "item/ResolvedDate": "@utcNow()",
                  "item/CloseNotes": "@{concat('Auto-resolved (retry) by PJ-Ticket-Resolver: provisioning job ', coalesce(outputs('Get_PJ_Fresh')?['body/Title'], ''), ' completed.')}"
                },
                "retryPolicy": {
                  "type": "fixed",
                  "count": 3,
                  "interval": "PT10S"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_Parent_Ticket": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@coalesce(outputs('Get_Parent_Ticket')?['body/TicketState/Value'], '')",
                    "Resolved"
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@coalesce(outputs('Get_Parent_Ticket')?['body/TicketState/Value'], '')",
                    "Closed"
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@coalesce(outputs('Get_Parent_Ticket')?['body/TicketState/Value'], '')",
                    "Cancelled"
                  ]
                }
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {
        "Get_PJ_Fresh": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {}
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_PJ_Fresh')?['body/JobStatus/Value']",
              "Succeeded"
            ]
          },
          {
            "not": {
              "startsWith": [
                "@coalesce(outputs('Get_PJ_Fresh')?['body/IdempotencyKey'], '')",
                "SCTASK-"
              ]
            }
          },
          {
            "greater": [
              "@coalesce(outputs('Get_PJ_Fresh')?['body/ParentTicket/Id'], 0)",
              0
            ]
          }
        ]
      },
      "type": "If"
    }
  },
  "description": "PJ-Ticket-Resolver. 2026-06-02 poll->push: trigger converted from GetOnUpdatedItems(Provisioning Jobs) to HTTP Request {pjId}. Called by the executor that completed a non-SCTASK PJ. Still re-reads live via Get_PJ_Fresh + terminal-state skip + Save-Conflict retry. #flowstudio-mcp"
}
